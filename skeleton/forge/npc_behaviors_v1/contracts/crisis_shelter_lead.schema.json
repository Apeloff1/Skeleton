{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crisis shelter lead NPC event",
  "description": "Validated deterministic command for shelter lead; host must independently authenticate world event and witness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "action",
    "effort",
    "tick",
    "expected_version",
    "destination",
    "witness"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "action": {
      "type": "string",
      "enum": [
        "observe",
        "work",
        "rest",
        "socialize",
        "travel",
        "retreat",
        "negotiate",
        "guard"
      ]
    },
    "effort": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0
    },
    "destination": {
      "type": "string",
      "enum": [
        "home",
        "market",
        "outpost",
        "sanctuary",
        "camp",
        "hall"
      ]
    },
    "witness": {
      "type": "string",
      "maxLength": 128
    }
  },
  "$comment": "Policy crisis_shelter_lead: work 7, rest 12, social 7, initial energy 75; version and timestamp fences enforced by engine."
}
