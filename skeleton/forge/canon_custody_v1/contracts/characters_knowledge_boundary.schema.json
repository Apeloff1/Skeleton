{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "characters_knowledge_boundary",
  "description": "Immutable characters knowledge_boundary canon append command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "entity",
    "action",
    "value",
    "predecessor",
    "evidence",
    "world",
    "tick",
    "expected_revision"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "entity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "action": {
      "type": "string",
      "enum": [
        "establish",
        "amend",
        "reconcile"
      ]
    },
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "predecessor": {
      "type": "string",
      "maxLength": 128
    },
    "evidence": {
      "type": "string",
      "minLength": 0,
      "maxLength": 128
    },
    "world": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$comment": "Schema validates command shape. The host must validate evidence provenance and persist ledger atomically."
}
