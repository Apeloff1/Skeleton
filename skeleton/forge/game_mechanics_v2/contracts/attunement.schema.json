{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "attunement event",
  "description": "Deterministic arcane mechanic command with bounded nonnegative amount and logical tick.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "action",
    "amount",
    "tick"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "action": {
      "type": "string",
      "enum": [
        "gain",
        "spend",
        "recover",
        "decay",
        "observe"
      ]
    },
    "amount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 140
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$comment": "attunement capacity 140; nominal gain 4, loss 7; supports replay-safe receipt identity."
}
