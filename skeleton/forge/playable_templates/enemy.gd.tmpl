extends CharacterBody2D
## Enemy — tiered state machine: idle/wander → chase (flow field) → windup
## (telegraphed) → strike/shoot → recover. Tier stats come from the era pack.

var main = null
var tier: String = "trash"
var label: String = "E"
var max_hp: float = 100.0
var hp: float = 100.0
var speed: float = 90.0
var damage: float = 10.0
var reach: float = 24.0
var aggro_tiles: int = 8
var windup: float = 0.4
var recover: float = 0.6
var radius: float = 11.0
var ranged: bool = false
var projectile_speed: float = 260.0
var reward: int = 1
var boss: bool = false
var relentless: bool = false
var color: Color = Color.RED
var state: String = "idle"
var alerted: bool = false
var phase: int = 1
var _timer: float = 0.0
var _home: Vector2 = Vector2.ZERO
var _wander_to: Vector2 = Vector2.ZERO
var _wander_t: float = 0.0
var _flash: float = 0.0
var _base_speed: float = 90.0
var _base_windup: float = 0.4


func configure(t: String, m) -> void:
	tier = t
	main = m
	var spec: Dictionary = Game.CONFIG["enemies"][t]
	max_hp = float(spec["hp"])
	hp = max_hp
	speed = float(spec["speed"])
	damage = float(spec["damage"])
	reach = float(spec["reach"])
	aggro_tiles = int(spec["aggro_tiles"])
	windup = float(spec["windup"])
	recover = float(spec["recover"])
	radius = float(spec["radius"])
	ranged = bool(spec.get("ranged", false))
	projectile_speed = float(spec.get("projectile_speed", 260.0))
	reward = int(spec.get("reward", 1))
	boss = bool(spec.get("boss", false))
	relentless = bool(spec.get("relentless", false))
	label = str(spec.get("label", "E"))
	color = Color.html(str(spec["color"]))
	_base_speed = speed
	_base_windup = windup


func _ready() -> void:
	add_to_group("enemy")
	if boss:
		add_to_group("boss")
	_home = position
	_wander_to = position
	var shape := CircleShape2D.new()
	shape.radius = radius
	$Body.shape = shape


func _physics_process(delta: float) -> void:
	_flash = max(0.0, _flash - delta)
	if Game.outcome != "" or main == null or main.player == null:
		return
	var player = main.player
	var dist: float = global_position.distance_to(player.global_position)
	match state:
		"idle":
			if player.alive and (alerted or main.flow_distance(global_position) <= aggro_tiles):
				state = "chase"
				alerted = true
			else:
				_wander(delta)
		"chase":
			if not player.alive:
				state = "idle"
				alerted = false
			elif ranged and dist <= reach and main.has_los(global_position, player.global_position):
				state = "windup"
				_timer = windup
			elif not ranged and dist <= reach + 10.0:
				state = "windup"
				_timer = windup
			elif not relentless and main.flow_distance(global_position) > aggro_tiles * 3:
				state = "idle"
				alerted = false
			else:
				var dir: Vector2 = main.chase_dir(global_position)
				velocity = velocity.move_toward(dir * speed, speed * 8.0 * delta)
		"windup":
			_timer -= delta
			velocity = velocity.move_toward(Vector2.ZERO, speed * 12.0 * delta)
			if _timer <= 0.0:
				_strike(player)
				state = "recover"
				_timer = recover
		"recover":
			_timer -= delta
			velocity = velocity.move_toward(Vector2.ZERO, speed * 12.0 * delta)
			if _timer <= 0.0:
				state = "chase" if player.alive else "idle"
	move_and_slide()


func _strike(player) -> void:
	if ranged:
		var dir: Vector2 = (player.global_position - global_position).normalized()
		var shots := 3 if boss else 1
		for i in range(shots):
			var spread := (i - (shots - 1) * 0.5) * 0.22
			main.spawn_projectile(global_position + dir * (radius + 4.0), dir.rotated(spread), projectile_speed, damage, false)
	elif global_position.distance_to(player.global_position) <= reach + 18.0:
		player.take_damage(damage, global_position)


func _wander(delta: float) -> void:
	_wander_t -= delta
	if _wander_t <= 0.0:
		_wander_t = Game.rng.randf_range(1.5, 3.5)
		var off := Vector2(Game.rng.randf_range(-48, 48), Game.rng.randf_range(-48, 48))
		if not main.is_wall(_home + off):
			_wander_to = _home + off
	var to := _wander_to - global_position
	if to.length() > 4.0:
		velocity = velocity.move_toward(to.normalized() * speed * 0.35, speed * 4.0 * delta)
	else:
		velocity = velocity.move_toward(Vector2.ZERO, speed * 4.0 * delta)


func take_damage(amount: float, from_pos: Vector2 = Vector2.ZERO) -> void:
	if hp <= 0.0:
		return
	hp -= amount
	_flash = 0.1
	alerted = true
	Game.bump("damage_dealt", amount)
	main.fx.spark(global_position, Color(1, 0.9, 0.5))
	if state == "idle":
		state = "chase"
	if not boss and from_pos != Vector2.ZERO:
		velocity += (global_position - from_pos).normalized() * 160.0
	if boss and phase == 1 and hp <= max_hp * 0.5:
		phase = 2
		speed = _base_speed * 1.3
		windup = _base_windup * 0.75
		Game.say("%s ENRAGES" % str(Game.get_cfg("rules.boss_name", "THE WARDEN")).to_upper())
		Game.log_event("boss_phase", "2")
	if hp <= 0.0:
		Game.bump("kills")
		main.fx.spark(global_position, color.lightened(0.4), "+%d" % reward)
		main.loop.on_enemy_killed(self)
		queue_free()


func reset_to_home() -> void:
	global_position = _home
	hp = max_hp
	phase = 1
	speed = _base_speed
	windup = _base_windup
	state = "idle"
	alerted = false
	velocity = Vector2.ZERO


func _process(_delta: float) -> void:
	queue_redraw()


func _draw() -> void:
	# PLACEHOLDER ART: enemy token by tier (see data/asset_manifest.json -> enemy_*).
	var c := Color(1, 1, 1) if _flash > 0.0 else color
	draw_circle(Vector2.ZERO, radius, c)
	draw_arc(Vector2.ZERO, radius, 0.0, TAU, 20, c.darkened(0.55), 2.0)
	draw_string(ThemeDB.fallback_font, Vector2(-4, 5), label, HORIZONTAL_ALIGNMENT_LEFT, -1, 12, Color(0, 0, 0, 0.8))
	if state == "windup":
		var k: float = 1.0 - _timer / max(windup, 0.01)
		draw_arc(Vector2.ZERO, radius + 4.0 + 10.0 * k, 0.0, TAU, 24, Color(1, 0.15, 0.1, 0.9), 3.0)
	if hp < max_hp:
		var w := radius * 2.4
		draw_rect(Rect2(-w * 0.5, -radius - 9, w, 4), Color(0, 0, 0, 0.6))
		draw_rect(Rect2(-w * 0.5, -radius - 9, w * clamp(hp / max_hp, 0.0, 1.0), 4), Color(0.9, 0.2, 0.2))
