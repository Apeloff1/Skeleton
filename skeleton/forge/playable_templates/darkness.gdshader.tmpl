shader_type canvas_item;
// Horror light cone: everything outside `radius` around the player fades to black.
uniform vec2 center = vec2(640.0, 360.0);
uniform vec2 rect_size = vec2(1280.0, 720.0);
uniform float radius = 160.0;
uniform float softness = 90.0;
uniform float flicker = 0.0;

void fragment() {
	vec2 p = UV * rect_size;
	float d = distance(p, center);
	float r = radius * (1.0 - flicker * 0.08);
	float a = smoothstep(r, r + softness, d);
	COLOR = vec4(0.0, 0.0, 0.02, clamp(a, 0.0, 0.97));
}
