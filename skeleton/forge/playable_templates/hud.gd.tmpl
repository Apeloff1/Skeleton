extends CanvasLayer
## HUD — objective, health/secondary bars, banners, companion line, end screen.
## Fonts/panels are PLACEHOLDER (engine fallback theme).

var main = null
var _title: Label
var _objective: Label
var _stats: Label
var _banner: Label
var _advisor: Label
var _placeholder: Label
var _hp_bar: ProgressBar
var _second_bar: ProgressBar
var _second_label: Label
var _end_panel: PanelContainer
var _end_label: Label
var _pause_label: Label
var _dark: ColorRect = null
var _banner_t: float = 0.0
var _advisor_t: float = 0.0


func setup(m) -> void:
	main = m
	layer = 10
	process_mode = Node.PROCESS_MODE_ALWAYS
	var root := Control.new()
	root.set_anchors_preset(Control.PRESET_FULL_RECT)
	root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(root)
	if main.loop.has_method("light_radius"):
		_dark = ColorRect.new()
		_dark.set_anchors_preset(Control.PRESET_FULL_RECT)
		_dark.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var mat := ShaderMaterial.new()
		mat.shader = load("res://shaders/darkness.gdshader")
		_dark.material = mat
		root.add_child(_dark)
	_title = _label(root, Vector2(16, 10), 22)
	_title.text = "%s  —  %s" % [str(Game.CONFIG["title"]), str(Game.CONFIG["loop_label"])]
	_objective = _label(root, Vector2(16, 40), 16)
	_hp_bar = _bar(root, Vector2(16, 66), Color.html("#d94a4a"))
	_second_bar = _bar(root, Vector2(16, 88), Color.html(str(Game.get_cfg("palette.accent", "#4ab3d9"))))
	_second_label = _label(root, Vector2(234, 85), 13)
	_stats = _label(root, Vector2(16, 110), 13)
	_banner = _label(root, Vector2.ZERO, 26)
	_banner.set_anchors_and_offsets_preset(Control.PRESET_CENTER_TOP)
	_banner.offset_top = 140
	_banner.offset_left = -500
	_banner.offset_right = 500
	_banner.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_advisor = _label(root, Vector2.ZERO, 15)
	_advisor.set_anchors_and_offsets_preset(Control.PRESET_CENTER_BOTTOM)
	_advisor.offset_top = -70
	_advisor.offset_left = -520
	_advisor.offset_right = 520
	_advisor.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_advisor.modulate = Color.html("#ffe9a8")
	_placeholder = _label(root, Vector2.ZERO, 11)
	_placeholder.set_anchors_and_offsets_preset(Control.PRESET_BOTTOM_RIGHT)
	_placeholder.offset_left = -430
	_placeholder.offset_top = -22
	_placeholder.text = "PLACEHOLDER ART & AUDIO — generated by Skeleton GameForge"
	_placeholder.modulate = Color(1, 1, 1, 0.55)
	_pause_label = _label(root, Vector2.ZERO, 30)
	_pause_label.set_anchors_and_offsets_preset(Control.PRESET_CENTER)
	_pause_label.offset_left = -300
	_pause_label.text = "PAUSED — Esc to resume, R to restart"
	_pause_label.visible = false
	_end_panel = PanelContainer.new()
	_end_panel.set_anchors_and_offsets_preset(Control.PRESET_CENTER)
	_end_panel.custom_minimum_size = Vector2(560, 190)
	_end_panel.offset_left = -280
	_end_panel.offset_top = -95
	_end_panel.visible = false
	root.add_child(_end_panel)
	_end_label = Label.new()
	_end_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_end_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	_end_label.add_theme_font_size_override("font_size", 22)
	_end_panel.add_child(_end_label)
	Game.banner.connect(_on_banner)
	Game.advisor.connect(_on_advisor)
	Game.run_finished.connect(_on_finished)
	_on_advisor(str(Game.get_cfg("companion.intro", "")))


func _label(parent: Control, pos: Vector2, font_size: int) -> Label:
	var l := Label.new()
	l.position = pos
	l.add_theme_font_size_override("font_size", font_size)
	l.add_theme_color_override("font_outline_color", Color(0, 0, 0))
	l.add_theme_constant_override("outline_size", 4)
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	parent.add_child(l)
	return l


func _bar(parent: Control, pos: Vector2, color: Color) -> ProgressBar:
	var b := ProgressBar.new()
	b.position = pos
	b.size = Vector2(210, 16)
	b.show_percentage = false
	var fill := StyleBoxFlat.new()
	fill.bg_color = color
	b.add_theme_stylebox_override("fill", fill)
	b.mouse_filter = Control.MOUSE_FILTER_IGNORE
	parent.add_child(b)
	return b


func _on_banner(text: String) -> void:
	_banner.text = text
	_banner_t = 2.6


func _on_advisor(text: String) -> void:
	if text == "":
		return
	_advisor.text = text
	_advisor_t = 5.0


func _on_finished(outcome: String) -> void:
	var headline := "RUN COMPLETE" if outcome == "win" else ("OUT OF TIME" if outcome == "timeout" else "RUN LOST")
	var flavour := str(Game.get_cfg("rules.win_text" if outcome == "win" else "rules.lose_text", ""))
	_end_label.text = "%s\n%s\n\n%s\nPress R to play again" % [headline, flavour, main.loop.hud_lines()]
	_end_panel.visible = true


func set_paused(p: bool) -> void:
	_pause_label.visible = p


func _process(delta: float) -> void:
	if main == null or main.player == null:
		return
	var p = main.player
	_objective.text = main.loop.objective_text()
	_hp_bar.max_value = p.max_hp
	_hp_bar.value = p.hp
	var sec: Array = main.loop.secondary_bar()
	_second_bar.visible = sec.size() == 3
	_second_label.visible = sec.size() == 3
	if sec.size() == 3:
		_second_label.text = str(sec[0])
		_second_bar.max_value = float(sec[2])
		_second_bar.value = float(sec[1])
	_stats.text = main.loop.hud_lines()
	_banner_t -= delta
	_banner.visible = _banner_t > 0.0
	_advisor_t -= delta
	_advisor.visible = _advisor_t > 0.0
	if _dark != null:
		var mat: ShaderMaterial = _dark.material
		var screen_pos: Vector2 = p.get_global_transform_with_canvas().origin
		mat.set_shader_parameter("center", screen_pos)
		mat.set_shader_parameter("rect_size", _dark.size)
		mat.set_shader_parameter("radius", main.loop.light_radius())
		mat.set_shader_parameter("flicker", main.loop.light_flicker())
