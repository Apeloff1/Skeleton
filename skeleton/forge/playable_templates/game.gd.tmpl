extends Node
## Game — run state, forged rules config and input bindings (autoload).
## Generated by Skeleton GameForge playable export; edit freely.

signal hp_changed(hp: float, max_hp: float)
signal banner(text: String)
signal advisor(text: String)
signal run_finished(outcome: String)

## Forged configuration: era pack numbers, level, rules for the chosen loop.
const CONFIG = __CONFIG__

var rng := RandomNumberGenerator.new()
var outcome: String = ""
var elapsed: float = 0.0
var stats: Dictionary = {}
var counters: Dictionary = {}
var events: Array = []
var autoplay: bool = false
var smoke_limit: float = 0.0
var _advisor_cd: Dictionary = {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for arg in OS.get_cmdline_user_args():
		if arg == "--autoplay":
			autoplay = true
		elif arg.begins_with("--smoke-seconds="):
			smoke_limit = float(arg.get_slice("=", 1))
	_bind_inputs()
	reset()


func reset() -> void:
	rng.seed = int(CONFIG["seed_int"])
	outcome = ""
	elapsed = 0.0
	stats = {"kills": 0, "shots": 0, "swings": 0, "pickups": 0, "deaths": 0,
		"damage_taken": 0.0, "damage_dealt": 0.0, "dodges": 0, "interactions": 0}
	counters = {}
	events = []
	_advisor_cd = {}


func get_cfg(path: String, fallback: Variant = null) -> Variant:
	var node: Variant = CONFIG
	for part in path.split("."):
		if typeof(node) != TYPE_DICTIONARY or not (node as Dictionary).has(part):
			return fallback
		node = node[part]
	return node


func bump(stat: String, amount: float = 1.0) -> void:
	stats[stat] = stats.get(stat, 0) + amount


func log_event(kind: String, detail: String = "") -> void:
	events.append({"t": snappedf(elapsed, 0.01), "kind": kind, "detail": detail})
	if events.size() > 256:
		events.pop_front()


func say(text: String) -> void:
	banner.emit(text)


## Companion (blueprint `jeeves` component) — throttled contextual advice.
func advise(topic: String) -> void:
	if not bool(get_cfg("companion.enabled", false)):
		return
	var lines: Dictionary = get_cfg("companion.lines", {})
	if not lines.has(topic):
		return
	if elapsed < float(_advisor_cd.get(topic, -1.0)):
		return
	_advisor_cd[topic] = elapsed + float(get_cfg("companion.cooldown", 8.0))
	var who: String = str(get_cfg("companion.name", "Jeeves"))
	advisor.emit("%s: %s" % [who, str(lines[topic])])
	log_event("advice", topic)


func finish(result: String) -> void:
	if outcome != "":
		return
	outcome = result
	log_event("finish", result)
	run_finished.emit(result)


func _process(delta: float) -> void:
	if outcome == "" and not get_tree().paused:
		elapsed += delta


func _bind_inputs() -> void:
	_bind("move_left", [KEY_A, KEY_LEFT])
	_bind("move_right", [KEY_D, KEY_RIGHT])
	_bind("move_up", [KEY_W, KEY_UP])
	_bind("move_down", [KEY_S, KEY_DOWN])
	_bind("attack", [KEY_SPACE, KEY_J], MOUSE_BUTTON_LEFT)
	_bind("dodge", [KEY_SHIFT, KEY_K], MOUSE_BUTTON_RIGHT)
	_bind("interact", [KEY_E, KEY_F])
	_bind("restart", [KEY_R])
	_bind("pause", [KEY_ESCAPE, KEY_P])


func _bind(action: String, keys: Array, mouse_button: int = -1) -> void:
	if not InputMap.has_action(action):
		InputMap.add_action(action)
	for key in keys:
		var ev := InputEventKey.new()
		ev.physical_keycode = key
		InputMap.action_add_event(action, ev)
	if mouse_button >= 0:
		var mb := InputEventMouseButton.new()
		mb.button_index = mouse_button
		InputMap.action_add_event(action, mb)
