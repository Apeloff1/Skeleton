{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-01:operation_envelope:v1",
  "title": "FLGB-01 Operation Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "request_digest",
    "authority_scope",
    "deadline_ms",
    "max_output_tokens",
    "idempotency_key"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_scope": {
      "const": "inference-proposal-only"
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "budget_class": {
      "enum": [
        "interactive",
        "batch",
        "evaluation",
        "recovery"
      ]
    }
  }
}
