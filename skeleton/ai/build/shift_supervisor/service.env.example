# Supervisor model/API configuration
OPENAI_API_KEY=
SHIFT_MODEL_API_URL=https://api.openai.com/v1/chat/completions
SHIFT_MODEL_NAME=gpt-5.6

# Exact requested plan cadences
SHIFT_SECRETARY_INTERVAL_SECONDS=900
SHIFT_MANAGER_INTERVAL_SECONDS=1800

# Staffing/overtime policy defaults
SHIFT_NORMAL_MINUTES=480
SHIFT_OVERTIME_SOFT_LIMIT_MINUTES=120

# Runtime project context (replace/inject from your existing service in production)
SHIFT_PROJECT_CONTEXT_JSON={"repository":"Apeloff1/Skeleton"}
