{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "epilogue_recovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "choice",
    "version",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "choice": {
      "type": "string",
      "enum": [
        "introduce",
        "listen",
        "reveal",
        "propose",
        "agree",
        "leave",
        "withdraw"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "evidence": {
      "type": "string",
      "maxLength": 128
    }
  }
}
