{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-17:source_provenance:v1",
  "title": "FLGB-17 source provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "source_digest",
    "rights_digest",
    "acquisition_digest",
    "transformation_chain_digest"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rights_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "acquisition_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transformation_chain_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
