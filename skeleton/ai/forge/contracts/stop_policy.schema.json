{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-17:stop_policy:v1",
  "title": "FLGB-17 stop policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "max_cycles",
    "minimum_delta_ppm",
    "patience",
    "maximum_risk_ppm"
  ],
  "properties": {
    "max_cycles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "minimum_delta_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "patience": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "maximum_risk_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  }
}
