{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-17:quality_delta:v1",
  "title": "FLGB-17 quality delta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline_digest",
    "candidate_digest",
    "baseline_score_ppm",
    "candidate_score_ppm",
    "evidence_digest"
  ],
  "properties": {
    "baseline_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseline_score_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "candidate_score_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
