{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-03:context_compression:v1",
  "title": "FLGB-03 context compression",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "source_digests",
    "source_tokens",
    "summary_digest",
    "summary_tokens",
    "preserved_mandatory_ids"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "source_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "summary_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "summary_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999999
    },
    "preserved_mandatory_ids": {
      "type": "array",
      "maxItems": 16384,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
