{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-03:episodic_memory:v1",
  "title": "FLGB-03 episodic memory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "sequence",
    "event_digest",
    "provenance_digest",
    "prior_episode_digest"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "event_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prior_episode_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
