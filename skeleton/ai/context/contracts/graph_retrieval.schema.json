{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-03:graph_retrieval:v1",
  "title": "FLGB-03 graph retrieval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "target",
    "relation"
  ],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "relation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
