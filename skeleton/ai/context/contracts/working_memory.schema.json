{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-03:working_memory:v1",
  "title": "FLGB-03 working memory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "value_digest",
    "provenance_digest",
    "revision"
  ],
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "value_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    }
  }
}
