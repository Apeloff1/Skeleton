{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-03:claim_evidence_graph:v1",
  "title": "FLGB-03 claim evidence graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "claim_id",
    "evidence_digest",
    "relation",
    "strength_ppm"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relation": {
      "enum": [
        "supports",
        "contradicts",
        "qualifies"
      ]
    },
    "strength_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  }
}
