{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-03:contradiction_handling:v1",
  "title": "FLGB-03 contradiction handling",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contradiction_id",
    "left_claim_id",
    "right_claim_id",
    "evidence_digest",
    "status",
    "resolution_digest"
  ],
  "properties": {
    "contradiction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "left_claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "right_claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "open",
        "resolved",
        "deferred"
      ]
    },
    "resolution_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
