{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-03:hybrid_retrieval:v1",
  "title": "FLGB-03 hybrid retrieval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "source",
    "content_digest",
    "provenance_digest",
    "lexical_ppm",
    "semantic_ppm",
    "freshness_ppm"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lexical_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "semantic_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "freshness_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  }
}
