{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-03:project_memory:v1",
  "title": "FLGB-03 project memory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "revision",
    "state_digest",
    "canon_digest",
    "provenance_digest",
    "parent_digest"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "state_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canon_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
