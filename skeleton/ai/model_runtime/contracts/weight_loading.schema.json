{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-02:weight_loading:v1",
  "title": "FLGB-02 weight loading",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_identity_digest",
    "shards",
    "expected_total_bytes"
  ],
  "properties": {
    "model_identity_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536
    },
    "expected_total_bytes": {
      "type": "integer",
      "minimum": 1
    }
  }
}
