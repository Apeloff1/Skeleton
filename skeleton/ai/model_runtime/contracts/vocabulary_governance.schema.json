{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-02:vocabulary_governance:v1",
  "title": "FLGB-02 vocabulary governance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tokenizer_id",
    "version",
    "tokens",
    "special_tokens"
  ],
  "properties": {
    "tokenizer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tokens": {
      "type": "array",
      "minItems": 1
    },
    "special_tokens": {
      "type": "object"
    }
  }
}
