{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-02:continuous_batching:v1",
  "title": "FLGB-02 continuous batching",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "prompt_tokens",
    "max_new_tokens",
    "priority"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "prompt_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "max_new_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "priority": {
      "type": "integer",
      "minimum": -1000000,
      "maximum": 1000000
    }
  }
}
