{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-02:model_lifecycle:v1",
  "title": "FLGB-02 model lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_identity_digest",
    "state",
    "generation"
  ],
  "properties": {
    "model_identity_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "registered",
        "loading",
        "ready",
        "draining",
        "stopped",
        "failed",
        "retired"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  }
}
