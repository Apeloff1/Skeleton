{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-04:multi_agent_arbitration:v1",
  "title": "FLGB-04 multi agent arbitration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "agent_id",
    "artifact_digest",
    "quality_ppm",
    "risk_ppm",
    "evidence_digest"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "quality_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "risk_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
