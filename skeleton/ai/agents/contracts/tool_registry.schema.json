{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-04:tool_registry:v1",
  "title": "FLGB-04 tool registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_name",
    "version",
    "schema_digest",
    "required_capabilities",
    "side_effect",
    "idempotent",
    "compensation_supported"
  ],
  "properties": {
    "tool_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "schema_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "required_capabilities": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "side_effect": {
      "enum": [
        "none",
        "read",
        "write",
        "external-write"
      ]
    },
    "idempotent": {
      "type": "boolean"
    },
    "compensation_supported": {
      "type": "boolean"
    }
  }
}
