{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-04:checkpointing:v1",
  "title": "FLGB-04 checkpointing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "sequence",
    "state_digest",
    "plan_digest",
    "authority_digest",
    "prior_checkpoint_digest"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "state_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prior_checkpoint_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
