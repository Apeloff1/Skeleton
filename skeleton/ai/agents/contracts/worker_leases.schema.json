{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-04:worker_leases:v1",
  "title": "FLGB-04 worker leases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lease_id",
    "worker_id",
    "scope_digest",
    "authority_digest",
    "issued_sequence",
    "expires_sequence",
    "generation"
  ],
  "properties": {
    "lease_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "worker_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "expires_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    }
  }
}
