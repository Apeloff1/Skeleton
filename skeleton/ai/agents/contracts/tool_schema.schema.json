{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-04:tool_schema:v1",
  "title": "FLGB-04 tool schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_name",
    "version",
    "input_schema",
    "output_schema"
  ],
  "properties": {
    "tool_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    }
  }
}
