{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-04:idempotent_writes:v1",
  "title": "FLGB-04 idempotent writes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "idempotency_key",
    "input_digest",
    "result_digest",
    "sequence"
  ],
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    }
  }
}
