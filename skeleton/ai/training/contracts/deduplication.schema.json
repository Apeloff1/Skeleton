{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-07:deduplication:v1",
  "title": "FLGB-07 deduplication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id",
    "fingerprint",
    "content_digest"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
