{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-07:adapter_training:v1",
  "title": "FLGB-07 adapter training",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "base_model_digest",
    "dataset_revision_digest",
    "target_modules",
    "config_digest",
    "output_kind"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "base_model_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset_revision_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_kind": {
      "const": "candidate-only"
    }
  }
}
