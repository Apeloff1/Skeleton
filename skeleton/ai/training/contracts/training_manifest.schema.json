{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-07:training_manifest:v1",
  "title": "FLGB-07 training manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "base_model_digest",
    "dataset_revision_digests",
    "code_digest",
    "config_digest",
    "seed_manifest_digest",
    "max_steps",
    "output_kind"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "base_model_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset_revision_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "code_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed_manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1
    },
    "output_kind": {
      "const": "candidate-only"
    }
  }
}
