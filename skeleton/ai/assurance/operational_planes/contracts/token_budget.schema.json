{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/token_budget.schema.json",
  "title": "runtime.token_budget observation contract",
  "description": "Enforce token accounting",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens_reserved_pct",
        "unaccounted_token_count"
      ],
      "properties": {
        "tokens_reserved_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 94,
          "description": "Upper bound for tokens_reserved_pct"
        },
        "unaccounted_token_count": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unaccounted_token_count"
        }
      }
    }
  }
}
