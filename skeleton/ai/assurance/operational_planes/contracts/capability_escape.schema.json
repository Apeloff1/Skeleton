{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/capability_escape.schema.json",
  "title": "security.capability_escape observation contract",
  "description": "Enforce capability boundaries",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unauthorized_capability_requests",
        "scope_crossings"
      ],
      "properties": {
        "unauthorized_capability_requests": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unauthorized_capability_requests"
        },
        "scope_crossings": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for scope_crossings"
        }
      }
    }
  }
}
