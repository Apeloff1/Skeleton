{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/tool_loop.schema.json",
  "title": "agents.tool_loop observation contract",
  "description": "Prevent repeated tool loops",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_calls_per_task",
        "repeated_identical_actions"
      ],
      "properties": {
        "tool_calls_per_task": {
          "type": "number",
          "minimum": 0,
          "maximum": 120,
          "description": "Upper bound for tool_calls_per_task"
        },
        "repeated_identical_actions": {
          "type": "number",
          "minimum": 0,
          "maximum": 8,
          "description": "Upper bound for repeated_identical_actions"
        }
      }
    }
  }
}
