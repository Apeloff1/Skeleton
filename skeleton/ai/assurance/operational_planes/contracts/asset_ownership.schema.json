{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/asset_ownership.schema.json",
  "title": "gameworld.asset_ownership observation contract",
  "description": "Require asset rights",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unlicensed_asset_count",
        "missing_asset_attribution"
      ],
      "properties": {
        "unlicensed_asset_count": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unlicensed_asset_count"
        },
        "missing_asset_attribution": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for missing_asset_attribution"
        }
      }
    }
  }
}
