{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/audit_coverage.schema.json",
  "title": "observability.audit_coverage observation contract",
  "description": "Require signed audit records",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unaudited_mutations",
        "missing_audit_signatures"
      ],
      "properties": {
        "unaudited_mutations": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unaudited_mutations"
        },
        "missing_audit_signatures": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for missing_audit_signatures"
        }
      }
    }
  }
}
