{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/telemetry_loss.schema.json",
  "title": "observability.telemetry_loss observation contract",
  "description": "Detect trace loss",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dropped_telemetry_events",
        "missing_trace_spans"
      ],
      "properties": {
        "dropped_telemetry_events": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Upper bound for dropped_telemetry_events"
        },
        "missing_trace_spans": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Upper bound for missing_trace_spans"
        }
      }
    }
  }
}
