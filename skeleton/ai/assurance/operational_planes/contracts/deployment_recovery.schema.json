{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/deployment_recovery.schema.json",
  "title": "release.deployment_recovery observation contract",
  "description": "Require healthy rollback evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unhealthy_canary_instances",
        "missing_rollback_receipts"
      ],
      "properties": {
        "unhealthy_canary_instances": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unhealthy_canary_instances"
        },
        "missing_rollback_receipts": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for missing_rollback_receipts"
        }
      }
    }
  }
}
