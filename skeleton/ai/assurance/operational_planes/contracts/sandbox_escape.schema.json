{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/sandbox_escape.schema.json",
  "title": "security.sandbox_escape observation contract",
  "description": "Guard sandbox confinement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sandbox_violation_count",
        "unexpected_host_writes"
      ],
      "properties": {
        "sandbox_violation_count": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for sandbox_violation_count"
        },
        "unexpected_host_writes": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unexpected_host_writes"
        }
      }
    }
  }
}
