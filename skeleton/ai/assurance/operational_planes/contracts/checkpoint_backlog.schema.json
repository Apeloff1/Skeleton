{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/checkpoint_backlog.schema.json",
  "title": "storage.checkpoint_backlog observation contract",
  "description": "Bound checkpoint debt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pending_checkpoints",
        "oldest_checkpoint_age_seconds"
      ],
      "properties": {
        "pending_checkpoints": {
          "type": "number",
          "minimum": 0,
          "maximum": 40,
          "description": "Upper bound for pending_checkpoints"
        },
        "oldest_checkpoint_age_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 600,
          "description": "Upper bound for oldest_checkpoint_age_seconds"
        }
      }
    }
  }
}
