{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/restore_gap.schema.json",
  "title": "storage.restore_gap observation contract",
  "description": "Reject unprovable restore points",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unrestorable_snapshots",
        "missing_recovery_records"
      ],
      "properties": {
        "unrestorable_snapshots": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unrestorable_snapshots"
        },
        "missing_recovery_records": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for missing_recovery_records"
        }
      }
    }
  }
}
