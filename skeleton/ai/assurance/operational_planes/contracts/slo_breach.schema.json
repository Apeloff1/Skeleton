{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/slo_breach.schema.json",
  "title": "observability.slo_breach observation contract",
  "description": "Monitor service SLOs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability_errors_per_hour",
        "latency_slo_breaches"
      ],
      "properties": {
        "availability_errors_per_hour": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "description": "Upper bound for availability_errors_per_hour"
        },
        "latency_slo_breaches": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "Upper bound for latency_slo_breaches"
        }
      }
    }
  }
}
