{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/retry_storm.schema.json",
  "title": "transport.retry_storm observation contract",
  "description": "Detect retry amplification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retry_attempts_per_min",
        "duplicate_delivery_count"
      ],
      "properties": {
        "retry_attempts_per_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 800,
          "description": "Upper bound for retry_attempts_per_min"
        },
        "duplicate_delivery_count": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "Upper bound for duplicate_delivery_count"
        }
      }
    }
  }
}
