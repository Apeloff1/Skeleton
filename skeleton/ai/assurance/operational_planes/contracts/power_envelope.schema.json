{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/power_envelope.schema.json",
  "title": "hardware.power_envelope observation contract",
  "description": "Bound device power",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_power_watts",
        "power_limit_events_per_min"
      ],
      "properties": {
        "device_power_watts": {
          "type": "number",
          "minimum": 0,
          "maximum": 240,
          "description": "Upper bound for device_power_watts"
        },
        "power_limit_events_per_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "description": "Upper bound for power_limit_events_per_min"
        }
      }
    }
  }
}
