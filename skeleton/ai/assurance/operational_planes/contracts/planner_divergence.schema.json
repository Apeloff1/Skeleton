{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/planner_divergence.schema.json",
  "title": "agents.planner_divergence observation contract",
  "description": "Require plan approvals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unverified_plan_edits",
        "unapproved_scope_changes"
      ],
      "properties": {
        "unverified_plan_edits": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unverified_plan_edits"
        },
        "unapproved_scope_changes": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unapproved_scope_changes"
        }
      }
    }
  }
}
