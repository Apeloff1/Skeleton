{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/cost_accounting.schema.json",
  "title": "observability.cost_accounting observation contract",
  "description": "Guard resource accounting",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unbilled_compute_units",
        "unreconciled_reservations"
      ],
      "properties": {
        "unbilled_compute_units": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unbilled_compute_units"
        },
        "unreconciled_reservations": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unreconciled_reservations"
        }
      }
    }
  }
}
