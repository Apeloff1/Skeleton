{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/evidence_gap.schema.json",
  "title": "agents.evidence_gap observation contract",
  "description": "Prohibit unsupported completion claims",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unsupported_claims",
        "missing_evidence_links"
      ],
      "properties": {
        "unsupported_claims": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unsupported_claims"
        },
        "missing_evidence_links": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for missing_evidence_links"
        }
      }
    }
  }
}
