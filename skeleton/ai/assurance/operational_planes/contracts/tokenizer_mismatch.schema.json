{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/tokenizer_mismatch.schema.json",
  "title": "models.tokenizer_mismatch observation contract",
  "description": "Require tokenizer compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenizer_contract_mismatches",
        "vocabulary_id_conflicts"
      ],
      "properties": {
        "tokenizer_contract_mismatches": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for tokenizer_contract_mismatches"
        },
        "vocabulary_id_conflicts": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for vocabulary_id_conflicts"
        }
      }
    }
  }
}
