{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/ci_failure.schema.json",
  "title": "release.ci_failure observation contract",
  "description": "Hold release for incomplete CI",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_failed_checks",
        "required_pending_checks"
      ],
      "properties": {
        "required_failed_checks": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for required_failed_checks"
        },
        "required_pending_checks": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for required_pending_checks"
        }
      }
    }
  }
}
