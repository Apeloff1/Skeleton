{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/wal_growth.schema.json",
  "title": "storage.wal_growth observation contract",
  "description": "Bound write ahead log backlog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wal_unflushed_mib",
        "wal_oldest_entry_age_seconds"
      ],
      "properties": {
        "wal_unflushed_mib": {
          "type": "number",
          "minimum": 0,
          "maximum": 1024,
          "description": "Upper bound for wal_unflushed_mib"
        },
        "wal_oldest_entry_age_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 120,
          "description": "Upper bound for wal_oldest_entry_age_seconds"
        }
      }
    }
  }
}
