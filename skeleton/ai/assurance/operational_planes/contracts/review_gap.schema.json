{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/review_gap.schema.json",
  "title": "release.review_gap observation contract",
  "description": "Require complete reviews",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unreviewed_sensitive_files",
        "unresolved_review_threads"
      ],
      "properties": {
        "unreviewed_sensitive_files": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unreviewed_sensitive_files"
        },
        "unresolved_review_threads": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unresolved_review_threads"
        }
      }
    }
  }
}
