{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/model_signature.schema.json",
  "title": "models.model_signature observation contract",
  "description": "Verify model weights",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unsigned_weight_shards",
        "weight_digest_mismatches"
      ],
      "properties": {
        "unsigned_weight_shards": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unsigned_weight_shards"
        },
        "weight_digest_mismatches": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for weight_digest_mismatches"
        }
      }
    }
  }
}
