{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/routing_mismatch.schema.json",
  "title": "models.routing_mismatch observation contract",
  "description": "Guard provider routing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_policy_violations",
        "unverified_model_switches"
      ],
      "properties": {
        "provider_policy_violations": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for provider_policy_violations"
        },
        "unverified_model_switches": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unverified_model_switches"
        }
      }
    }
  }
}
