{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/thermal_throttle.schema.json",
  "title": "hardware.thermal_throttle observation contract",
  "description": "Guard thermal envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_temperature_c",
        "thermal_throttle_events_per_min"
      ],
      "properties": {
        "device_temperature_c": {
          "type": "number",
          "minimum": 0,
          "maximum": 90,
          "description": "Upper bound for device_temperature_c"
        },
        "thermal_throttle_events_per_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Upper bound for thermal_throttle_events_per_min"
        }
      }
    }
  }
}
