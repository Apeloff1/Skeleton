{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/scene_consistency.schema.json",
  "title": "gameworld.scene_consistency observation contract",
  "description": "Guard scene graph integrity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unresolved_scene_edges",
        "orphaned_scene_nodes"
      ],
      "properties": {
        "unresolved_scene_edges": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unresolved_scene_edges"
        },
        "orphaned_scene_nodes": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for orphaned_scene_nodes"
        }
      }
    }
  }
}
