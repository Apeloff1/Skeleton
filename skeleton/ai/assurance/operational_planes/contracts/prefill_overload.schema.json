{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/prefill_overload.schema.json",
  "title": "runtime.prefill_overload observation contract",
  "description": "Bound prefill batch contention",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefill_batch_latency_ms",
        "prefill_queue_depth"
      ],
      "properties": {
        "prefill_batch_latency_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 3000,
          "description": "Upper bound for prefill_batch_latency_ms"
        },
        "prefill_queue_depth": {
          "type": "number",
          "minimum": 0,
          "maximum": 40,
          "description": "Upper bound for prefill_queue_depth"
        }
      }
    }
  }
}
