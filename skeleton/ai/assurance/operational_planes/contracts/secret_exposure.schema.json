{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/secret_exposure.schema.json",
  "title": "security.secret_exposure observation contract",
  "description": "Block leaked secrets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detected_secret_leaks",
        "unredacted_secret_fields"
      ],
      "properties": {
        "detected_secret_leaks": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for detected_secret_leaks"
        },
        "unredacted_secret_fields": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for unredacted_secret_fields"
        }
      }
    }
  }
}
