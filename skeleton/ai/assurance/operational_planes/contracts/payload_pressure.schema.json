{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/payload_pressure.schema.json",
  "title": "transport.payload_pressure observation contract",
  "description": "Guard payload expansion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_size_kib",
        "decode_expansion_ratio"
      ],
      "properties": {
        "payload_size_kib": {
          "type": "number",
          "minimum": 0,
          "maximum": 10240,
          "description": "Upper bound for payload_size_kib"
        },
        "decode_expansion_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "description": "Upper bound for decode_expansion_ratio"
        }
      }
    }
  }
}
