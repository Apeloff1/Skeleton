{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/handoff_loss.schema.json",
  "title": "agents.handoff_loss observation contract",
  "description": "Preserve work ownership",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orphaned_handoffs",
        "stale_assignments"
      ],
      "properties": {
        "orphaned_handoffs": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "Upper bound for orphaned_handoffs"
        },
        "stale_assignments": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Upper bound for stale_assignments"
        }
      }
    }
  }
}
