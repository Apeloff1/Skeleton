{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/ai/assurance/operational_planes/contracts/host_memory.schema.json",
  "title": "hardware.host_memory observation contract",
  "description": "Bound host memory pressure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at",
    "measurements"
  ],
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Source event Unix epoch seconds; consumers supply independent current time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resident_memory_used_pct",
        "memory_fault_rate"
      ],
      "properties": {
        "resident_memory_used_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 92,
          "description": "Upper bound for resident_memory_used_pct"
        },
        "memory_fault_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 500,
          "description": "Upper bound for memory_fault_rate"
        }
      }
    }
  }
}
