{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-06:golden_fixtures:v1",
  "title": "FLGB-06 golden fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "version",
    "input_digest",
    "expected_digest",
    "provenance_digest",
    "parent_digest"
  ],
  "properties": {
    "fixture_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
