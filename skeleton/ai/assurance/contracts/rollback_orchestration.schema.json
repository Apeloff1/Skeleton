{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-06:rollback_orchestration:v1",
  "title": "FLGB-06 rollback orchestration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "action_id",
    "forward_receipt_digest",
    "rollback_input_digest"
  ],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "forward_receipt_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rollback_input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
