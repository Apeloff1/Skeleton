{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-06:release_qualification:v1",
  "title": "FLGB-06 release qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_digest",
    "exact_head_commit",
    "gates",
    "independent_verifier"
  ],
  "properties": {
    "candidate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "exact_head_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000
    },
    "independent_verifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
