{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-06:trace_correlation:v1",
  "title": "FLGB-06 trace correlation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "span_id",
    "parent_span_id",
    "sequence",
    "event_digest"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "span_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "parent_span_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "event_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
