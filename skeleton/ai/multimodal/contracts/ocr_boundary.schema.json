{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-08:ocr_boundary:v1",
  "title": "FLGB-08 ocr boundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "image_digest",
    "language_hints",
    "max_output_chars",
    "untrusted_input"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "image_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "language_hints": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "max_output_chars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "untrusted_input": {
      "const": true
    }
  }
}
