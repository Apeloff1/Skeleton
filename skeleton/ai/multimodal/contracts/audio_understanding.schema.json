{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-08:audio_understanding:v1",
  "title": "FLGB-08 audio understanding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "segment_id",
    "start_ms",
    "end_ms",
    "label",
    "score_ppm",
    "evidence_digest"
  ],
  "properties": {
    "segment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0
    },
    "end_ms": {
      "type": "integer",
      "minimum": 1
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "score_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
