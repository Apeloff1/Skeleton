{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-08:document_vision:v1",
  "title": "FLGB-08 document vision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "page_index",
    "page_image_digest",
    "layout_digest",
    "provenance_digest"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "page_index": {
      "type": "integer",
      "minimum": 0
    },
    "page_image_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "layout_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
