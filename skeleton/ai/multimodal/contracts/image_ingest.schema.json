{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-08:image_ingest:v1",
  "title": "FLGB-08 image ingest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "content_digest",
    "mime_type",
    "width",
    "height",
    "byte_size",
    "provenance_digest",
    "rights_digest"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mime_type": {
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "image/gif",
        "image/avif"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "byte_size": {
      "type": "integer",
      "minimum": 1
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rights_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
