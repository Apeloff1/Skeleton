{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-01:replay_receipt:v1",
  "title": "FLGB-01 Replay Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "request_digest",
    "event_chain_digest",
    "result_digest",
    "terminal_commit_digest",
    "replay_generation"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_chain_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "terminal_commit_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replay_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  }
}
