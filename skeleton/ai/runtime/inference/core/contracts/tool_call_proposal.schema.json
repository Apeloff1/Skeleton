{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-01:tool_call_proposal:v1",
  "title": "FLGB-01 Tool Call Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "operation_id",
    "tool_name",
    "arguments",
    "requested_capabilities",
    "authority_scope"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tool_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "arguments": {
      "type": "object"
    },
    "requested_capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "authority_scope": {
      "const": "proposal-only"
    }
  }
}
