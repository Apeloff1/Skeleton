{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-05:secret_isolation:v1",
  "title": "FLGB-05 secret isolation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "redacted_text",
    "finding_digests"
  ],
  "properties": {
    "redacted_text": {
      "type": "string",
      "maxLength": 2000000
    },
    "finding_digests": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
