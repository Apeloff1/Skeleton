{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-05:prompt_injection_resistance:v1",
  "title": "FLGB-05 prompt injection resistance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "category",
    "evidence_digest",
    "severity"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    }
  }
}
