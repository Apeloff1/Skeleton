{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-05:approval_gates:v1",
  "title": "FLGB-05 approval gates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_id",
    "action",
    "required_approvals",
    "approver_roles"
  ],
  "properties": {
    "gate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "required_approvals": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "approver_roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
