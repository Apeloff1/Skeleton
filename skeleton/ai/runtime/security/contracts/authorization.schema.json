{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-05:authorization:v1",
  "title": "FLGB-05 authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowed",
    "reason",
    "request_digest"
  ],
  "properties": {
    "allowed": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
