{
  "type": "object",
  "fields": {
    "host": {
      "type": "text",
      "max_bytes": 96,
      "pattern": "^[A-Za-z0-9.:_-]+$"
    },
    "method": {
      "type": "text",
      "max_bytes": 64,
      "enum": [
        "POST",
        "GET",
        "PUT"
      ]
    },
    "auth_type": {
      "type": "text",
      "max_bytes": 64,
      "enum": [
        "bearer",
        "none",
        "cookie"
      ]
    },
    "token_bytes": {
      "type": "int",
      "min": 0,
      "max": 512
    },
    "body_bytes": {
      "type": "int",
      "min": 0,
      "max": 40000000
    },
    "body_ceiling": {
      "type": "int",
      "min": 1,
      "max": 40000000
    },
    "content_type": {
      "type": "text",
      "max_bytes": 80,
      "pattern": "^[A-Za-z0-9/+.-]+$"
    }
  }
}
