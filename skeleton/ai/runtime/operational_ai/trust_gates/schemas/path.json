{
  "type": "object",
  "fields": {
    "relative_path": {
      "type": "text",
      "max_bytes": 240
    },
    "root_id": {
      "type": "text",
      "max_bytes": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "entry_type": {
      "type": "text",
      "max_bytes": 64,
      "enum": [
        "model",
        "manifest",
        "fixture",
        "script"
      ]
    },
    "bytes": {
      "type": "int",
      "min": 0,
      "max": 1000000000
    },
    "byte_limit": {
      "type": "int",
      "min": 1,
      "max": 1000000000
    },
    "suffix": {
      "type": "text",
      "max_bytes": 16,
      "pattern": "^\\.[a-z0-9]+$"
    },
    "immutable": {
      "type": "bool"
    }
  }
}
