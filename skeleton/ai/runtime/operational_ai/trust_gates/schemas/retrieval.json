{
  "type": "object",
  "fields": {
    "source_id": {
      "type": "text",
      "max_bytes": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "text": {
      "type": "text",
      "max_bytes": 16384
    },
    "span_start": {
      "type": "int",
      "min": 0,
      "max": 16384
    },
    "span_end": {
      "type": "int",
      "min": 0,
      "max": 16384
    },
    "excerpt": {
      "type": "text",
      "max_bytes": 8192
    },
    "source_sha": {
      "type": "text",
      "max_bytes": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved": {
      "type": "bool"
    }
  }
}
