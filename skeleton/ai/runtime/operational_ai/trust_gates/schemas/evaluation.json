{
  "type": "object",
  "fields": {
    "suite_id": {
      "type": "text",
      "max_bytes": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "dataset_sha": {
      "type": "text",
      "max_bytes": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_sha": {
      "type": "text",
      "max_bytes": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "samples": {
      "type": "int",
      "min": 0,
      "max": 100000000
    },
    "passes": {
      "type": "int",
      "min": 0,
      "max": 100000000
    },
    "failures": {
      "type": "int",
      "min": 0,
      "max": 100000000
    },
    "empty_errors": {
      "type": "int",
      "min": 0,
      "max": 100000000
    },
    "approved": {
      "type": "bool"
    }
  }
}
