{
  "type": "object",
  "fields": {
    "session_id": {
      "type": "text",
      "max_bytes": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "fields": {
          "role": {
            "type": "text",
            "max_bytes": 64,
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "text",
            "max_bytes": 32768,
            "allow_empty": true
          }
        }
      },
      "min_items": 1,
      "max_items": 128
    },
    "max_bytes": {
      "type": "int",
      "min": 1,
      "max": 262144
    },
    "revision": {
      "type": "int",
      "min": 0,
      "max": 1000000
    },
    "final_role": {
      "type": "text",
      "max_bytes": 64,
      "enum": [
        "system",
        "user",
        "assistant"
      ]
    }
  }
}
