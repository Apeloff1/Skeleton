{
  "type": "object",
  "fields": {
    "model_id": {
      "type": "text",
      "max_bytes": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "digest": {
      "type": "text",
      "max_bytes": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
      "type": "int",
      "min": 1,
      "max": 20000000000
    },
    "shard_bytes": {
      "type": "array",
      "items": {
        "type": "int",
        "min": 0,
        "max": 100000000
      },
      "min_items": 1,
      "max_items": 64
    },
    "license": {
      "type": "text",
      "max_bytes": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "approved": {
      "type": "bool"
    },
    "source": {
      "type": "text",
      "max_bytes": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    }
  }
}
