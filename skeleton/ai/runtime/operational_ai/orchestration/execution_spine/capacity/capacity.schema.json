{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/contracts/context-capacity-v1",
  "title": "Operational AI context capacity decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "projection_sha256", "history_sha256", "candidate_evidence_sha256", "selected_evidence_sha256", "retained_turns", "omitted_turns", "evidence_candidates", "retained_sources", "omitted_sources", "planning_trials", "token_admission", "native_prompt_tokens", "conservative_estimated_tokens", "proof_sha256"],
  "properties": {
    "schema": {"const":"skeleton.ai.context-capacity.v1"},
    "projection_sha256":{"$ref":"#/$defs/digest"},
    "history_sha256":{"$ref":"#/$defs/digest"},
    "candidate_evidence_sha256":{"$ref":"#/$defs/digest"},
    "selected_evidence_sha256":{"$ref":"#/$defs/digest"},
    "proof_sha256":{"$ref":"#/$defs/digest"},
    "retained_turns":{"type":"integer","minimum":0},
    "omitted_turns":{"type":"integer","minimum":0},
    "evidence_candidates":{"type":"integer","minimum":0},
    "retained_sources":{"type":"integer","minimum":0},
    "omitted_sources":{"type":"integer","minimum":0},
    "planning_trials":{"type":"integer","minimum":1,"maximum":8192},
    "token_admission":{"enum":["exact-backend-count-admitted","native-backend-must-enforce-unknown-precount"]},
    "native_prompt_tokens":{"type":["integer","null"],"minimum":0},
    "conservative_estimated_tokens":{"type":"integer","minimum":0}
  },
  "$defs":{"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
