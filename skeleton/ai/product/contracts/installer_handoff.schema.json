{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-18:installer_handoff:v1",
  "title": "FLGB-18 installer handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_digest",
    "installer_manifest_digest",
    "provenance_digest",
    "signing_digest",
    "target_platforms",
    "verification_digest"
  ],
  "properties": {
    "package_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "installer_manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signing_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "verification_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
