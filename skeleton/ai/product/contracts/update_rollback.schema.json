{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-18:update_rollback:v1",
  "title": "FLGB-18 update rollback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "current_release_digest",
    "target_release_digest",
    "update_package_digest",
    "rollback_artifact_digest",
    "migration_digest",
    "rollback_test_digest"
  ],
  "properties": {
    "current_release_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_release_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "update_package_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rollback_artifact_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "migration_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rollback_test_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
