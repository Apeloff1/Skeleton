{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-18:project_bootstrap:v1",
  "title": "FLGB-18 project bootstrap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "template_digest",
    "seed_digest",
    "rights_digest",
    "settings_digest",
    "requested_worlds"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "template_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rights_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "settings_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requested_worlds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
