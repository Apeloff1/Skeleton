{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-07:mirror_room_evaluation:v1",
  "title": "FLGB-07 mirror room evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_id",
    "candidate_digest",
    "champion_digest",
    "candidate_score_ppm",
    "champion_score_ppm",
    "risk_gate_passed",
    "independent_verifier",
    "evidence_digest"
  ],
  "properties": {
    "evaluation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "champion_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_score_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "champion_score_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "risk_gate_passed": {
      "type": "boolean"
    },
    "independent_verifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
