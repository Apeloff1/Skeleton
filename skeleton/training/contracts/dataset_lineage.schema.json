{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-07:dataset_lineage:v1",
  "title": "FLGB-07 dataset lineage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "revision",
    "content_digest",
    "rights_digest",
    "transform_digest",
    "parent_digest"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rights_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transform_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
