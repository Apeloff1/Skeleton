{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-05:tenant_isolation:v1",
  "title": "FLGB-05 tenant isolation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_digest",
    "boundary_digest",
    "operation",
    "allowed",
    "reason_code"
  ],
  "properties": {
    "scope_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "boundary_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "allowed": {
      "type": "boolean"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
