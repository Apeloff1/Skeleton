{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-14:style_bible:v1",
  "title": "FLGB-14 style bible",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bible_id",
    "version",
    "required_tags",
    "forbidden_tags",
    "reference_digest"
  ],
  "properties": {
    "bible_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "required_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "forbidden_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "reference_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
