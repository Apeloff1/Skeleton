{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-14:character_generation:v1",
  "title": "FLGB-14 character generation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "archetype_id",
    "trait_pool",
    "required_traits"
  ],
  "properties": {
    "archetype_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "trait_pool": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "required_traits": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
