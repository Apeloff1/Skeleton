{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-14:continuity_verifier:v1",
  "title": "FLGB-14 continuity verifier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "category",
    "severity",
    "evidence_digest"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ]
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
