{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-14:lore_graph:v1",
  "title": "FLGB-14 lore graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lore_id",
    "statement_digest",
    "evidence_digest",
    "tags"
  ],
  "properties": {
    "lore_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "statement_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
