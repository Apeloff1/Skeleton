{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-14:quest_generation:v1",
  "title": "FLGB-14 quest generation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quest_id",
    "seed_digest",
    "objective_ids",
    "dependency_ids",
    "canon_digest"
  ],
  "properties": {
    "quest_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "seed_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "objective_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "dependency_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "canon_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
