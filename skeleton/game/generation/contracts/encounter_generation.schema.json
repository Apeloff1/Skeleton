{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-14:encounter_generation:v1",
  "title": "FLGB-14 encounter generation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "encounter_id",
    "seed_digest",
    "difficulty",
    "actor_ids",
    "reward_digest"
  ],
  "properties": {
    "encounter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "seed_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "difficulty": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "actor_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "reward_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
