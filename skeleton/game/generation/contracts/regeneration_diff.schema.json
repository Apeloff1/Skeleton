{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-14:regeneration_diff:v1",
  "title": "FLGB-14 regeneration diff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_id",
    "before_digest",
    "after_digest",
    "added_ids",
    "removed_ids",
    "changed_ids",
    "seed_digest"
  ],
  "properties": {
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "before_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "after_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "added_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "removed_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "changed_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "seed_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
