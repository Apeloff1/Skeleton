{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-14:regeneration_diff:v1",
  "title": "FLGB-14 regeneration diff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "content_digest",
    "locked"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locked": {
      "type": "boolean"
    }
  }
}
