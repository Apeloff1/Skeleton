{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-14:seed_contract:v1",
  "title": "FLGB-14 seed contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "root_seed_digest",
    "generator_version"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "root_seed_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generator_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
