{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-14:timeline_consistency:v1",
  "title": "FLGB-14 timeline consistency",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "start_tick",
    "end_tick",
    "subject_ids",
    "event_digest"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "start_tick": {
      "type": "integer",
      "minimum": 0
    },
    "end_tick": {
      "type": "integer",
      "minimum": 0
    },
    "subject_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "event_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
