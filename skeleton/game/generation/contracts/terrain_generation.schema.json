{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-14:terrain_generation:v1",
  "title": "FLGB-14 terrain generation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chunk_id",
    "seed_digest",
    "x",
    "y",
    "size",
    "height_digest",
    "biome_digest"
  ],
  "properties": {
    "chunk_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "seed_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "x": {
      "type": "integer"
    },
    "y": {
      "type": "integer"
    },
    "size": {
      "type": "integer",
      "minimum": 1
    },
    "height_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "biome_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
