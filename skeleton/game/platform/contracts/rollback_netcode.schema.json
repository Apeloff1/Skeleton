{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-15:rollback_netcode:v1",
  "title": "FLGB-15 rollback netcode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tick",
    "state_digest",
    "input_digest",
    "prior_frame_digest"
  ],
  "properties": {
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "state_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prior_frame_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
