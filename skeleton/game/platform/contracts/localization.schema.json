{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-15:localization:v1",
  "title": "FLGB-15 localization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "locale",
    "text_digest",
    "source_locale"
  ],
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "locale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "text_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_locale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
