{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-15:cloud_save:v1",
  "title": "FLGB-15 cloud save",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slot_id",
    "revision",
    "save_digest",
    "device_id",
    "parent_digest"
  ],
  "properties": {
    "slot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "save_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "parent_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
