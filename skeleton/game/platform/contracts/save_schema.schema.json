{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-15:save_schema:v1",
  "title": "FLGB-15 save schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "version",
    "state_digest",
    "world_digest",
    "metadata_digest"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "state_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "world_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
