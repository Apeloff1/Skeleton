{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-16:package_build:v1",
  "title": "FLGB-16 package build",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "version",
    "entry_digests",
    "build_graph_digest",
    "signing_digest"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "entry_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "build_graph_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signing_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
