{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-16:automated_playtest:v1",
  "title": "FLGB-16 automated playtest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "seed_digest",
    "terminal_state_digest",
    "passed",
    "assertion_digest"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "seed_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "terminal_state_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "passed": {
      "type": "boolean"
    },
    "assertion_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
