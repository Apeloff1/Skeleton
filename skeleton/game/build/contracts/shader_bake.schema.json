{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-16:shader_bake:v1",
  "title": "FLGB-16 shader bake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shader_id",
    "source_digest",
    "compiler_digest",
    "target",
    "binary_digest"
  ],
  "properties": {
    "shader_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compiler_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "binary_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
