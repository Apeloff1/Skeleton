{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-16:release_artifact_verification:v1",
  "title": "FLGB-16 release artifact verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_digest",
    "provenance_digest",
    "signature_digest",
    "sbom_digest",
    "test_evidence_digest"
  ],
  "properties": {
    "artifact_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sbom_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "test_evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
