{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-09:project_manifest:v1",
  "title": "FLGB-09 project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "format_version",
    "engine_contract_digest",
    "world_ids",
    "asset_catalog_digest",
    "settings_digest",
    "provenance_digest"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "format_version": {
      "type": "integer",
      "minimum": 1
    },
    "engine_contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "world_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "asset_catalog_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "settings_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
