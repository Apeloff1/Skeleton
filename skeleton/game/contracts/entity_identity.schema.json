{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-09:entity_identity:v1",
  "title": "FLGB-09 entity identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_id",
    "world_id",
    "generation"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    }
  }
}
