{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-09:editor_transaction:v1",
  "title": "FLGB-09 editor transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transaction_id",
    "project_id",
    "base_revision",
    "idempotency_key",
    "operations",
    "authority_scope"
  ],
  "properties": {
    "transaction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000
    },
    "authority_scope": {
      "const": "editor-transaction-only"
    }
  }
}
