{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-09:editor_transaction:v1",
  "title": "FLGB-09 editor transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transaction_id",
    "project_digest_before",
    "project_digest_after",
    "operations",
    "authority_digest",
    "idempotency_key"
  ],
  "properties": {
    "transaction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_digest_before": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project_digest_after": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000
    },
    "authority_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
