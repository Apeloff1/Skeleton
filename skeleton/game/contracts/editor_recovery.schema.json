{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-09:editor_recovery:v1",
  "title": "FLGB-09 editor recovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_id",
    "sequence",
    "durable_state_digest",
    "pending_transaction_digest",
    "prior_checkpoint_digest"
  ],
  "properties": {
    "checkpoint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "durable_state_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pending_transaction_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "prior_checkpoint_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
