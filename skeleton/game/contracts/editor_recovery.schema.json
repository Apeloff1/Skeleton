{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-09:editor_recovery:v1",
  "title": "FLGB-09 editor recovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "sequence",
    "project_digest",
    "history_digest",
    "pending_transaction_digest",
    "prior_checkpoint_digest"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "project_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "history_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pending_transaction_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "prior_checkpoint_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
