{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-09:world_identity:v1",
  "title": "FLGB-09 world identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "world_id",
    "project_id",
    "generation",
    "seed_digest"
  ],
  "properties": {
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "seed_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
