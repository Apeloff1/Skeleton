{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-09:prefab_inheritance:v1",
  "title": "FLGB-09 prefab inheritance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prefab_id",
    "parent_prefab_id",
    "component_digests"
  ],
  "properties": {
    "prefab_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "parent_prefab_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "component_digests": {
      "type": "array",
      "maxItems": 1000000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
