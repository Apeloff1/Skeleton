{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-09:asset_references:v1",
  "title": "FLGB-09 asset references",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "kind",
    "content_digest",
    "provenance_digest",
    "rights_digest"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rights_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
