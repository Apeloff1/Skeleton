{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-10:character_controller:v1",
  "title": "FLGB-10 character controller",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_id",
    "position",
    "max_speed_per_sec",
    "grounded"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "position": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer"
      }
    },
    "max_speed_per_sec": {
      "type": "integer",
      "minimum": 1
    },
    "grounded": {
      "type": "boolean"
    }
  }
}
