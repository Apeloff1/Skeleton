{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-10:fixed_timestep:v1",
  "title": "FLGB-10 fixed timestep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_us",
    "max_steps_per_advance"
  ],
  "properties": {
    "step_us": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "max_steps_per_advance": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  }
}
