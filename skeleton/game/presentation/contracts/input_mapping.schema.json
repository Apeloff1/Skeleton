{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-12:input_mapping:v1",
  "title": "FLGB-12 input mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "device_kind",
    "control_id",
    "scale_milli"
  ],
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "device_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "control_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scale_milli": {
      "type": "integer"
    }
  }
}
