{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-12:animation_graph:v1",
  "title": "FLGB-12 animation graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state_id",
    "clip_digest",
    "loop",
    "speed_milli"
  ],
  "properties": {
    "state_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "clip_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "loop": {
      "type": "boolean"
    },
    "speed_milli": {
      "type": "integer",
      "minimum": 1
    }
  }
}
