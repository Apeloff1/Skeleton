{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-12:controller_support:v1",
  "title": "FLGB-12 controller support",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "controller_id",
    "vendor_id",
    "product_id",
    "controls",
    "haptics"
  ],
  "properties": {
    "controller_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "vendor_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "product_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "haptics": {
      "type": "boolean"
    }
  }
}
