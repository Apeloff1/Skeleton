{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-12:controller_support:v1",
  "title": "FLGB-12 controller support",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "controller_id",
    "vendor_id",
    "product_id",
    "capabilities"
  ],
  "properties": {
    "controller_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "vendor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "product_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
