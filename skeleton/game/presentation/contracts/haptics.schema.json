{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-12:haptics:v1",
  "title": "FLGB-12 haptics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pattern_id",
    "segments"
  ],
  "properties": {
    "pattern_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096
    }
  }
}
