{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-12:music_state:v1",
  "title": "FLGB-12 music state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state_id",
    "stem_digests",
    "bpm_milli",
    "beats_per_bar"
  ],
  "properties": {
    "state_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "stem_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "bpm_milli": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "beats_per_bar": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    }
  }
}
