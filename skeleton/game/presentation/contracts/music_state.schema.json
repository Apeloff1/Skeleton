{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-12:music_state:v1",
  "title": "FLGB-12 music state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state_id",
    "track_digest",
    "intensity_ppm"
  ],
  "properties": {
    "state_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "track_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intensity_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  }
}
