{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-12:procedural_animation:v1",
  "title": "FLGB-12 procedural animation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layer_id",
    "algorithm",
    "seed_digest",
    "parameter_digest",
    "priority"
  ],
  "properties": {
    "layer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "algorithm": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "seed_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parameter_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "priority": {
      "type": "integer"
    }
  }
}
