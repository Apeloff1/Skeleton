{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-12:procedural_animation:v1",
  "title": "FLGB-12 procedural animation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modifier_id",
    "kind",
    "config_digest",
    "seed",
    "weight_ppm"
  ],
  "properties": {
    "modifier_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed": {
      "type": "integer"
    },
    "weight_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  }
}
