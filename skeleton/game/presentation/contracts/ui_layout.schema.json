{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-12:ui_layout:v1",
  "title": "FLGB-12 ui layout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "parent_id",
    "x",
    "y",
    "width",
    "height",
    "z_index"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "x": {
      "type": "integer"
    },
    "y": {
      "type": "integer"
    },
    "width": {
      "type": "integer",
      "minimum": 0
    },
    "height": {
      "type": "integer",
      "minimum": 0
    },
    "z_index": {
      "type": "integer"
    }
  }
}
