{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-12:ui_layout:v1",
  "title": "FLGB-12 ui layout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "parent_id",
    "role",
    "rect",
    "visible"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "rect": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer"
      }
    },
    "visible": {
      "type": "boolean"
    }
  }
}
