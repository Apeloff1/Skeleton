{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-11:particle_vfx:v1",
  "title": "FLGB-11 particle vfx",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "emitter_id",
    "max_particles",
    "spawn_rate_milli",
    "seed",
    "material_digest"
  ],
  "properties": {
    "emitter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "max_particles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "spawn_rate_milli": {
      "type": "integer",
      "minimum": 0
    },
    "seed": {
      "type": "integer"
    },
    "material_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
