{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-11:mesh_pipeline:v1",
  "title": "FLGB-11 mesh pipeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh_id",
    "vertex_digest",
    "index_digest",
    "vertex_count",
    "index_count",
    "topology",
    "provenance_digest"
  ],
  "properties": {
    "mesh_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "vertex_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "index_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vertex_count": {
      "type": "integer",
      "minimum": 1
    },
    "index_count": {
      "type": "integer",
      "minimum": 1
    },
    "topology": {
      "enum": [
        "triangles",
        "lines",
        "points"
      ]
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
