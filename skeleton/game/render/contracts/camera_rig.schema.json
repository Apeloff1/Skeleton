{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-11:camera_rig:v1",
  "title": "FLGB-11 camera rig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rig_id",
    "cameras",
    "active_camera_id"
  ],
  "properties": {
    "rig_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "cameras": {
      "type": "array",
      "minItems": 1
    },
    "active_camera_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
