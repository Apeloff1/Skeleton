{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-11:material_graph:v1",
  "title": "FLGB-11 material graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "op",
    "input_nodes",
    "parameter_digest"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "op": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "input_nodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "parameter_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
