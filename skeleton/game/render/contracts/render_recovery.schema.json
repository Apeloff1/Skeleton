{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-11:render_recovery:v1",
  "title": "FLGB-11 render recovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frame_id",
    "graph_digest",
    "resource_state_digest",
    "pipeline_cache_digest",
    "prior_checkpoint_digest"
  ],
  "properties": {
    "frame_id": {
      "type": "integer",
      "minimum": 0
    },
    "graph_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resource_state_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pipeline_cache_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prior_checkpoint_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
