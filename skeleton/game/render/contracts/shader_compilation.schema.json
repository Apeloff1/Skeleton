{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-11:shader_compilation:v1",
  "title": "FLGB-11 shader compilation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shader_id",
    "source_digest",
    "stage",
    "target",
    "defines"
  ],
  "properties": {
    "shader_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stage": {
      "enum": [
        "vertex",
        "fragment",
        "compute",
        "geometry",
        "mesh",
        "task"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "defines": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
