{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-11:shadow_system:v1",
  "title": "FLGB-11 shadow system",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "light_id",
    "x",
    "y",
    "size"
  ],
  "properties": {
    "light_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "x": {
      "type": "integer",
      "minimum": 0
    },
    "y": {
      "type": "integer",
      "minimum": 0
    },
    "size": {
      "type": "integer",
      "minimum": 1
    }
  }
}
