{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-11:lighting_model:v1",
  "title": "FLGB-11 lighting model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "light_id",
    "kind",
    "intensity_milli",
    "range_mm",
    "color_digest",
    "casts_shadow"
  ],
  "properties": {
    "light_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "enum": [
        "directional",
        "point",
        "spot",
        "area"
      ]
    },
    "intensity_milli": {
      "type": "integer",
      "minimum": 0
    },
    "range_mm": {
      "type": "integer",
      "minimum": 0
    },
    "color_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "casts_shadow": {
      "type": "boolean"
    }
  }
}
