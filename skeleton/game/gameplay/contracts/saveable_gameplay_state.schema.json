{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-13:saveable_gameplay_state:v1",
  "title": "FLGB-13 saveable gameplay state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "world_id",
    "schema_version",
    "tick",
    "state_digest",
    "canon_digest",
    "parent_save_digest"
  ],
  "properties": {
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "state_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canon_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_save_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
