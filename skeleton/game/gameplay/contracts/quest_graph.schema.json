{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-13:quest_graph:v1",
  "title": "FLGB-13 quest graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quest_id",
    "dependencies",
    "completion_digest"
  ],
  "properties": {
    "quest_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "completion_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
