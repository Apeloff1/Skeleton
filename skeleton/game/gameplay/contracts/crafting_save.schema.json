{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-13:crafting-save:v1",
  "title": "Offline source-bound crafting save",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_digest",
    "actions",
    "state",
    "state_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "recipe_id",
          "batches"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "recipe_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "batches": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_id",
        "plan_digest",
        "inventory",
        "currency",
        "flags"
      ],
      "properties": {
        "world_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inventory": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "currency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "flags": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "state_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
