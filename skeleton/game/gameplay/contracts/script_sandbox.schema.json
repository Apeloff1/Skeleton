{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-13:script_sandbox:v1",
  "title": "FLGB-13 script sandbox",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "script_id",
    "allowed_capabilities",
    "instruction_budget",
    "memory_bytes"
  ],
  "properties": {
    "script_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "allowed_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "instruction_budget": {
      "type": "integer",
      "minimum": 1
    },
    "memory_bytes": {
      "type": "integer",
      "minimum": 1
    }
  }
}
