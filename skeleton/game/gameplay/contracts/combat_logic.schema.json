{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-13:combat_logic:v1",
  "title": "FLGB-13 combat logic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "priority",
    "condition_digest",
    "effect_digest"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "priority": {
      "type": "integer"
    },
    "condition_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "effect_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
