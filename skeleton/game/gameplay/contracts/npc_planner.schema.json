{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-13:npc_planner:v1",
  "title": "FLGB-13 npc planner",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "preconditions",
    "effects",
    "cost"
  ],
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "preconditions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "effects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "cost": {
      "type": "integer",
      "minimum": 0
    }
  }
}
