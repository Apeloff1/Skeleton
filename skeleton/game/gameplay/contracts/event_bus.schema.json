{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skeleton:flgb-13:event_bus:v1",
  "title": "FLGB-13 event bus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "event_type",
    "source_id",
    "payload_digest"
  ],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
