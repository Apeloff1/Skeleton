{
  "schema_version": 1,
  "app": {
    "name": "Skeleton",
    "version": "16",
    "compose_file": "docker-compose.yml",
    "hot_compose_file": "docker-compose.hot.yml",
    "modes": {
      "development": {
        "BUILD_TARGET": "development",
        "FRONTEND_BUILD_TARGET": "development",
        "FRONTEND_CONTAINER_PORT": "3000",
        "ENVIRONMENT": "development",
        "NODE_ENV": "development",
        "DEBUG": "false"
      },
      "production": {
        "BUILD_TARGET": "production",
        "FRONTEND_BUILD_TARGET": "production",
        "FRONTEND_CONTAINER_PORT": "8080",
        "ENVIRONMENT": "production",
        "NODE_ENV": "production",
        "DEBUG": "false"
      }
    },
    "default_services": [
      "mongo",
      "skeleton",
      "backend",
      "frontend"
    ],
    "full_services": [
      "mongo",
      "chroma",
      "skeleton",
      "backend",
      "frontend"
    ]
  },
  "architecture": {
    "contract": "machine/architecture.json",
    "validator": "scripts/check_architecture_map.py",
    "documentation": "docs/ARCHITECTURE_MAP.md",
    "tag": "arch-map/v3.5",
    "structure_tag": "structure-map/v1.2"
  },
  "runtime": {
    "required_env": [
      "MONGO_URL",
      "SKL_MONGO_URI",
      "MONGO_INITDB_ROOT_PASSWORD",
      "JWT_SECRET"
    ],
    "optional_env": [
      "OPENAI_API_KEY",
      "STRIPE_API_KEY",
      "SKELETON_MASTER_SECRET",
      "GF_SEAL_SECRET",
      "EXPO_PUBLIC_BACKEND_URL",
      "EXPO_PUBLIC_SKELETON_URL"
    ]
  },
  "services": [
    {
      "name": "frontend",
      "role": "human-interface",
      "path": "frontend",
      "kind": "expo",
      "public_url": "http://localhost:3000",
      "health_path": "/",
      "container_port": 3000,
      "depends_on": [
        "backend",
        "skeleton"
      ],
      "canonical": true
    },
    {
      "name": "backend",
      "role": "application-api",
      "path": "backend",
      "kind": "fastapi",
      "entrypoint": "server:app",
      "public_url": "http://localhost:8001",
      "health_path": "/api/health",
      "container_port": 8001,
      "depends_on": [
        "mongo"
      ],
      "canonical": true
    },
    {
      "name": "skeleton",
      "role": "engine-api",
      "path": "skeleton",
      "kind": "fastapi",
      "entrypoint": "skeleton.api.server:create_app",
      "public_url": "http://localhost:8010",
      "health_path": "/api/v1/health/live",
      "container_port": 8001,
      "depends_on": [
        "mongo"
      ],
      "canonical": true
    },
    {
      "name": "mongo",
      "role": "durable-store",
      "path": "docker-compose.yml",
      "kind": "database",
      "container_port": 27017,
      "depends_on": [],
      "canonical": true
    },
    {
      "name": "chroma",
      "role": "vector-store",
      "path": "docker-compose.yml",
      "kind": "database",
      "public_url": "http://localhost:8000",
      "container_port": 8000,
      "depends_on": [],
      "canonical": false,
      "profile": "full"
    }
  ],
  "required_paths": [
    "pyproject.toml",
    "docker-compose.yml",
    "docker-compose.hot.yml",
    "Dockerfile",
    "backend/server.py",
    "backend/Dockerfile",
    "frontend/package.json",
    "frontend/Dockerfile",
    "skeleton/__main__.py",
    "skeleton/api/server.py",
    "frontend/app/product.tsx",
    "frontend/utils/apiBase.ts",
    "frontend/nginx.conf",
    "backend/core/product_kernel.py",
    "backend/core/canonical_product_policy.py",
    "backend/core/product_control_runtime.py",
    "backend/routes/product_runtime.py",
    "machine/architecture.json",
    "docs/ARCHITECTURE_MAP.md",
    "scripts/check_architecture_map.py",
    "scripts/check_app_assembly.py",
    "skeleton/testing/test_architecture_map.py",
    "scripts/check_source_path_inventory.py",
    "machine/ai_app_construction.json",
    "docs/AI_APP_CONSTRUCTION_MANUAL.md",
    "scripts/check_ai_app_construction.py",
    "scripts/check_provider_bootstrap.py",
    "backend/core/provider_architecture.py",
    "AGENTS.md",
    "CLAUDE.md",
    ".github/copilot-instructions.md",
    ".cursor/rules/architecture.mdc",
    "skeleton/provider_contract.py",
    "skeleton/testing/test_provider_contract.py",
    "GEMINI.md",
    "skeleton/vault/data_governance.py",
    "skeleton/intelligence/admission.py",
    "skeleton/testing/test_data_governance.py",
    "skeleton/testing/test_cost_admission.py",
    "backend/tests/test_ai_provider_media.py",
    "backend/routes/image_generation.py",
    "backend/routes/ai_reader.py",
    "backend/core/expressive_tts.py",
    "skeleton/contracts/operation.py",
    "skeleton/frontier/operation_stream.py",
    "skeleton/testing/test_operation_contract.py",
    "skeleton/testing/test_operation_stream.py",
    "skeleton/frontier/operation_stream_store.py",
    "skeleton/testing/test_operation_stream_store.py",
    "skeleton/frontier/model_routing.py"
  ],
  "construction": {
    "contract": "machine/ai_app_construction.json",
    "manual": "docs/AI_APP_CONSTRUCTION_MANUAL.md",
    "validator": "scripts/check_ai_app_construction.py",
    "provider_bootstrap_validator": "scripts/check_provider_bootstrap.py",
    "provider_activation_boundary": "backend/core/ai_provider.py",
    "provider_architecture_loader": "skeleton/provider_contract.py",
    "provider_architecture_compatibility_loader": "backend/core/provider_architecture.py",
    "construction_version": "3.5.0",
    "provider_runtime_boundary": "skeleton/provider_runtime.py",
    "operation_contract": "skeleton/contracts/operation.py",
    "stream_contract": "skeleton/frontier/operation_stream.py",
    "stream_store": "skeleton/frontier/operation_stream_store.py",
    "model_routing_owner": "skeleton/frontier/model_routing.py",
    "relationship_semantics": "depends_on=runtime dependency; validates=acceptance target"
  }
}
