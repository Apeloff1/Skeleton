{
  "schema_version": 1,
  "app": {
    "name": "Skeleton",
    "version": "16",
    "compose_file": "docker-compose.yml",
    "hot_compose_file": "docker-compose.hot.yml",
    "modes": {
      "development": {
        "BUILD_TARGET": "development",
        "FRONTEND_BUILD_TARGET": "development",
        "FRONTEND_CONTAINER_PORT": "3000",
        "ENVIRONMENT": "development",
        "NODE_ENV": "development",
        "DEBUG": "false"
      },
      "production": {
        "BUILD_TARGET": "production",
        "FRONTEND_BUILD_TARGET": "production",
        "FRONTEND_CONTAINER_PORT": "8080",
        "ENVIRONMENT": "production",
        "NODE_ENV": "production",
        "DEBUG": "false"
      }
    },
    "default_services": [
      "mongo",
      "skeleton",
      "backend",
      "frontend"
    ],
    "full_services": [
      "mongo",
      "chroma",
      "skeleton",
      "backend",
      "frontend"
    ]
  },
  "runtime": {
    "required_env": [
      "MONGO_URL",
      "SKL_MONGO_URI",
      "MONGO_INITDB_ROOT_PASSWORD",
      "JWT_SECRET"
    ],
    "optional_env": [
      "OPENAI_API_KEY",
      "EMERGENT_LLM_KEY",
      "STRIPE_API_KEY",
      "SKELETON_MASTER_SECRET",
      "GF_SEAL_SECRET",
      "EXPO_PUBLIC_BACKEND_URL",
      "EXPO_PUBLIC_SKELETON_URL"
    ]
  },
  "services": [
    {
      "name": "frontend",
      "role": "human-interface",
      "path": "frontend",
      "kind": "expo",
      "public_url": "http://localhost:3000",
      "health_path": "/",
      "container_port": 3000,
      "depends_on": [
        "backend",
        "skeleton"
      ],
      "canonical": true
    },
    {
      "name": "backend",
      "role": "application-api",
      "path": "backend",
      "kind": "fastapi",
      "entrypoint": "server:app",
      "public_url": "http://localhost:8001",
      "health_path": "/api/health",
      "container_port": 8001,
      "depends_on": [
        "mongo"
      ],
      "canonical": true
    },
    {
      "name": "skeleton",
      "role": "engine-api",
      "path": "skeleton",
      "kind": "fastapi",
      "entrypoint": "skeleton.api.server:create_app",
      "public_url": "http://localhost:8010",
      "health_path": "/api/v1/health/live",
      "container_port": 8001,
      "depends_on": [
        "mongo"
      ],
      "canonical": true
    },
    {
      "name": "mongo",
      "role": "durable-store",
      "path": "docker-compose.yml",
      "kind": "database",
      "container_port": 27017,
      "depends_on": [],
      "canonical": true
    },
    {
      "name": "chroma",
      "role": "vector-store",
      "path": "docker-compose.yml",
      "kind": "database",
      "public_url": "http://localhost:8000",
      "container_port": 8000,
      "depends_on": [],
      "canonical": false,
      "profile": "full"
    }
  ],
  "required_paths": [
    "pyproject.toml",
    "docker-compose.yml",
    "docker-compose.hot.yml",
    "Dockerfile",
    "backend/server.py",
    "backend/Dockerfile",
    "frontend/package.json",
    "frontend/Dockerfile",
    "skeleton/__main__.py",
    "skeleton/api/server.py",
    "frontend/app/product.tsx",
    "frontend/utils/apiBase.ts",
    "frontend/nginx.conf",
    "backend/core/product_kernel.py",
    "backend/core/canonical_product_policy.py",
    "backend/core/product_control_runtime.py",
    "backend/routes/product_runtime.py",
    "scripts/check_app_assembly.py",
    "skeleton/app/preloader.py",
    "skeleton/app/setup_runtime.py",
    "skeleton/app/installer.py",
    "scripts/install_app.py",
    "skeleton/app/windows_launcher.py",
    "packaging/windows/launcher_entry.py",
    "packaging/windows/SkeletonSetup.iss",
    "scripts/windows/build_installer.ps1"
  ]
}
