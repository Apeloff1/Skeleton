# Repository/editor metadata
.git
.vscode
.idea

# Local dependency/build trees
node_modules
.expo
.metro-cache
web-build
dist
coverage

# Never send local credentials or runtime configuration to the frontend builder.
.env
.env.*
..env.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
credentials*.json
service-account*.json

# Local scratch/log files
*.log
*.tmp
*.bak

# COPY . includes nested project source. Keep private material and runtime
# journals excluded throughout the subtree; no exceptions below this fence.
.runtime/
**/.env
**/.env.*
**/..env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt
**/*.cer
**/credentials*.json
**/service-account*.json
**/.runtime/
