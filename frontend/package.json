{
  "name": "frontend",
  "description": "Skeleton studio application: Jeeves chat, Dragon crawler and game creation workspaces.",
  "main": "expo-router/entry",
  "version": "16.0.0",
  "scripts": {
    "check:expo-native-compat": "node ./scripts/check-expo-native-compat.cjs",
    "start": "expo start --port 3000",
    "postinstall": "node ./scripts/patch-node-modules.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:ci": "expo lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "typecheck:jeeves": "tsc --noEmit --project tsconfig.jeeves.json",
    "test:jeeves": "node --test scripts/test-jeeves-workspace.cjs scripts/jeeves-workbench/*.test.cjs",
    "export:web": "expo export --platform web",
    "audit:policy:test": "node ./scripts/test-enforce-yarn-audit.js",
    "audit:known-advisories": "node ./scripts/audit-known-yarn-advisories.cjs",
    "audit:known-advisories:report": "node ./scripts/audit-known-yarn-advisories.cjs --report-only",
    "test:known-advisories": "node --test ./scripts/test-known-yarn-advisories.cjs",
    "test:operation-stream": "node --test scripts/test-operation-stream-reducer.mjs scripts/test-operation-stream-session.mjs",
    "test:conversation": "node --test scripts/test-conversation-projection.mjs scripts/test-chat-error-boundary.mjs",
    "test:dragon-companion": "node scripts/test-dragon-companion.cjs && node scripts/test-dragon-living-motion.cjs && node scripts/test-dragon-progression.cjs && node scripts/test-dragon-journal-chain.cjs",
    "test:skeleton-forge": "node --test scripts/skeleton-forge/*.test.cjs",
    "test:forge-operator": "node --test scripts/forge-operator/*.test.cjs",
    "test:app-foundation": "node --test scripts/test-app-foundation-flows.mjs",
