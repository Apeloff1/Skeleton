    "test:stability": "node --experimental-strip-types --test scripts/test-startup-stability.mjs scripts/test-request-recovery.mjs scripts/test-trace-write-queue.mjs scripts/test-storage-retention.mjs scripts/test-crash-commit-order.mjs scripts/test-native-mutation-fence.mjs scripts/test-long-session-stability.cjs scripts/test-marathon-pressure.cjs scripts/test-session-transition-pressure.cjs scripts/test-offline-cache-integrity.cjs scripts/test-memory-pressure-runtime.cjs scripts/test-operation-stream-endurance.cjs scripts/test-persistent-preferences-endurance.cjs scripts/test-build-observer-endurance.cjs scripts/test-timer-resume-endurance.cjs scripts/test-connectivity-probe.cjs scripts/test-native-mirror-memory.cjs scripts/test-month-cycle-ledger.cjs scripts/test-month-cycle-recovery.cjs scripts/test-month-cycle-integration.cjs scripts/test-month-cycle-foreground.cjs",
    "test:knowledge-experience": "node --test scripts/test-knowledge-experience.mjs",
    "test:world-workbench": "node --test scripts/test-world-workbench.mjs",
    "test:story-continuity": "node --test scripts/test-story-continuity.mjs",
    "test:design-review": "node --test scripts/test-design-review.mjs",
    "test:stability:reconciliation": "node --test scripts/test-reconciled-stability.cjs",
    "test:env": "node --test scripts/validate-public-env.test.cjs",
    "validate:env": "node scripts/validate-public-env.cjs",
    "test:foundation-tokens": "node --test scripts/test-foundation-tokens.cjs"
