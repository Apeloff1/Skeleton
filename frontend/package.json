    "test:product-projection": "node --test scripts/test-product-projection.mjs",
    "test:accessibility": "node --test scripts/test-accessibility-contract.mjs",
    "test:canonical-theme": "node --test scripts/test-canonical-theme.cjs",
    "test:localization": "node --test scripts/test-localization-contract.mjs",
    "test:dragon-wire": "node scripts/test-dragon-canonical-wire.cjs",
    "test:dragon-native-editor": "node --test scripts/test-dragon-native-puzzle-preview.mjs scripts/test-dragon-native-puzzle-history.mjs",
    "test:product-journeys": "node --test scripts/test-product-journeys.mjs scripts/test-jeeves-model-inventory.mjs scripts/test-app-foundation-flows.mjs",
    "test:build-lifecycle": "node --test scripts/test-build-job-lifecycle.mjs",
