# ============================================================================
# Tutolage Frontend (Expo) - Environment Template
# Copy to frontend/.env and fill in real values. NEVER commit .env.
# ============================================================================

# Legacy CodeDock / backend API base URL (Expo requires the EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# Hexagonal Skeleton API base URL (used by frontend/services/skeleton.ts)
EXPO_PUBLIC_SKELETON_URL=http://localhost:8010

# Optional: keep the on-device boot diagnostics overlay enabled in production.
# Development builds show it automatically; production defaults to disabled.
EXPO_PUBLIC_DEV_LOG_OVERLAY=0
