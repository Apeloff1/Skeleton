# Legacy CodeDock / backend API base URL (Expo requires the EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# Hexagonal Skeleton API base URL (frontend/services/skeleton.ts)
EXPO_PUBLIC_SKELETON_URL=http://localhost:8010
