{
  "expo": {
    "name": "Skeleton",
    "description": "Local-first game studio with Jeeves AI chat, Dragon source review, editing, play and bounded training.",
    "slug": "codedock-quantum-nexus",
    "version": "16.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "codedock",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "EXPO_BACKEND_URL": "",
      "EXPO_PUBLIC_BACKEND_URL": "",
      "EXPO_PUBLIC_SKELETON_URL": ""
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codedock.quantumnexus",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSMicrophoneUsageDescription": "Used by voice commands and audio dictation.",
        "NSCameraUsageDescription": "Used by code/QR scanning helpers.",
        "NSPhotoLibraryUsageDescription": "Used to import images into your projects.",
        "NSLocationWhenInUseUsageDescription": "Used only while the app is open, after you tap to start Frontier live GPS, to place you on the game map. Location is not stored, uploaded or used in the background."
      }
    },
    "android": {
      "package": "com.codedock.quantumnexus",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used only while the app is open, after you tap to start Frontier live GPS, to place you on the game map. Location is not stored, uploaded or used in the background.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3B82F6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
