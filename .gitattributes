# Normalize line endings; keep shells/scripts LF.
* text=auto eol=lf

# Treat large/binary artifacts as binary (no diff/merge noise).
*.zip   binary
*.apk   binary
*.aab   binary
*.ipa   binary
*.bson  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary

# Model/checkpoint formats belong in Git LFS rather than ordinary Git blobs.
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.gguf        filter=lfs diff=lfs merge=lfs -text
*.ckpt        filter=lfs diff=lfs merge=lfs -text
*.pt          filter=lfs diff=lfs merge=lfs -text
*.pth         filter=lfs diff=lfs merge=lfs -text
*.onnx        filter=lfs diff=lfs merge=lfs -text
*.tflite      filter=lfs diff=lfs merge=lfs -text

# Mark generated data so GitHub's language stats ignore it.
memory/mongo_backup/** linguist-generated
backend/data/**        linguist-generated
test_result.md         linguist-generated
