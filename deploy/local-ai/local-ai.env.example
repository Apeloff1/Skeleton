# Local AI overlay tuning. Values may be copied into private root .env.
# This file contains NO application credentials and does not provision weights.
SKL_LOCAL_AI_IMAGE=skeleton-local-ai:dev
SKL_LOCAL_AI_MEMORY=8g
SKL_LOCAL_AI_CPUS=4
SKL_LOCAL_AI_SHM_SIZE=256m
SKL_LOCAL_AI_PIDS_LIMIT=512
SKL_LOCAL_AI_CONCURRENCY=1
SKL_LOCAL_AI_QUEUE=8
SKL_LOCAL_AI_BATCH=8
SKL_LOCAL_AI_TIMEOUT=120
# Set for an AMD Linux host only, after checking id -G / getent group render.
# SKL_LOCAL_AI_RENDER_GID=109
# SKL_LOCAL_AI_HIP_VISIBLE_DEVICES=0
# NVIDIA selection requires the matching container toolkit, driver and runtime.
# SKL_LOCAL_AI_NVIDIA_DEVICES=all
