# Backend runtime config for ENVIRONMENT=staging. Validated by backend/config/environment.py.
# Non-secret values may be edited here. Secret keys are listed with EMPTY values:
# supply them from the deploy platform's secret store, never commit them.
ENVIRONMENT=staging
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
DB_NAME=tutolage
CORS_ORIGINS=https://staging.example.org
# APP_VERSION is baked into release images by the release workflow.
APP_VERSION=
# --- secrets (names only) ---
MONGO_URL=
JWT_SECRET=
OPS_TOKEN=
ADVANCED_API_TOKEN=
OPENAI_API_KEY=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
GAMEFORGE_JWT_SECRET=
GF_SEAL_SECRET=
GF_KEYHOLDER_SEED=
SKL_ENGINE_SERVICE_TOKEN=
