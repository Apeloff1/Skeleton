  "benchmark_required_fields": [
    "cold_wall_ms",
    "warm_median_ms",
    "warm_cache_hit_ratios",
    "graph_nodes",
    "graph_edges",
    "external_dependency_components",
    "declared_dependency_records",
    "route_count",
    "build_target_count",
    "search_document_count",
    "history_window_commits"
  ],
  "rule": "Performance and quality claims must cite measured telemetry from a specific tree/CI run. Targets in quality-budgets.json are not evidence by themselves, and hotspot/batch evidence signals are not quality or completion scores."
}
