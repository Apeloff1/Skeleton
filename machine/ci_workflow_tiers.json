{
  "schema": "skeleton.ci.workflow_tiers.v1",
  "purpose": "fast iteration without falsely clearing specialized acceptance",
  "specialized_manual_only": [
    "app-assembly.yml",
    "arm64.yml",
    "ai-product-completion.yml",
    "ai-p0-current-main-validation.yml",
    "p3t2-governed-storage.yml",
