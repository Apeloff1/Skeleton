    ],
    "source-bound-custody-qualification.yml": [
      "workflow_dispatch",
      "pull_request"
    ],
    "windows-installer.yml": [
      "workflow_dispatch",
      "pull_request"
    ],
    "workflow-input-security.yml": [
      "pull_request",
      "push"
    ]
  },
  "operational_scheduled_non_pr": [
    "queue-drain.yml"
  ],
  "operational_paused_manual_only": [
    "actions-housekeeping-cli.yml",
    "three-hour-actions-queue-expiry.yml"
  ]
}
