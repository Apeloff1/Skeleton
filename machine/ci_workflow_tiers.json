{
  "schema": "skeleton.ci.workflow_tiers.v1",
  "purpose": "fast iteration without falsely clearing specialized acceptance",
  "specialized_manual_only": [
    "app-assembly.yml",
    "arm64.yml",
    "ai-product-completion.yml",
    "ai-p0-current-main-validation.yml",
    "p3t2-governed-storage.yml",
    "p3t2-governed-data.yml",
    "frontier-contracts.yml",
    "packaging-runtime-image.yml",
    "cost-admission-closure.yml",
    "governance-closure.yml"
  ],
  "core_automatic_pr": [
    "merge-readiness.yml",
    "backend-quality.yml",
    "secret-scanning.yml",
    "malware-gate.yml",
    "dependency-review.yml",
    "workflow-input-security.yml"
  ],
  "release_rules": {
    "all_specialized_not_run_is_unqualified": true,
    "security_gates_remain_enabled": true,
    "full_p0_signoff_requires_separate_exact_head_evidence": true,
    "fast_merge_gate_not_full_qualification": true
  },
  "required_reusable_workflows": [
    "ci.yml"
  ],
  "automatic_event_workflows": [
    "app-foundation-e2e.yml",
    "artifact-policy.yml",
    "automation-traffic-manager.yml",
    "automerge-control-plane.yml",
    "backend-quality.yml",
    "dependency-review.yml",
    "engine-transport-source-qualification.yml",
    "first-install-source-qualification.yml",
    "game-frontier-validation.yml",
    "jeeves-integrated-source-qualification.yml",
    "jeeves-laptop-dispatcher-source-tests.yml",
    "jeeves-native-sqlite-source-qualification.yml",
    "local-first-engine-source-qualification.yml",
    "malware-gate.yml",
    "masterplan-421-dossier-integrity.yml",
    "merge-readiness.yml",
    "queue-drain.yml",
    "release-images.yml",
    "repository-hygiene-gate.yml",
    "reproducible-release.yml",
    "sealed-context-guard.yml",
    "secret-scanning.yml",
    "security-alert-inventory.yml",
    "source-bound-custody-qualification.yml",
    "windows-installer.yml",
    "workflow-input-security.yml"
  ],
  "automatic_event_triggers": {
    "app-foundation-e2e.yml": [
      "pull_request",
      "push",
      "workflow_dispatch"
    ],
    "artifact-policy.yml": [
      "pull_request",
      "workflow_dispatch",
      "schedule"
    ],
    "automation-traffic-manager.yml": [
      "schedule",
      "workflow_dispatch"
    ],
    "automerge-control-plane.yml": [
      "workflow_run"
    ],
    "backend-quality.yml": [
      "push",
      "pull_request",
      "workflow_dispatch"
    ],
    "dependency-review.yml": [
      "pull_request"
    ],
    "engine-transport-source-qualification.yml": [
      "pull_request"
    ],
    "first-install-source-qualification.yml": [
      "pull_request"
    ],
    "game-frontier-validation.yml": [
      "pull_request",
      "workflow_dispatch"
    ],
    "jeeves-integrated-source-qualification.yml": [
      "pull_request"
    ],
    "jeeves-laptop-dispatcher-source-tests.yml": [
      "pull_request"
    ],
    "jeeves-native-sqlite-source-qualification.yml": [
      "pull_request"
    ],
    "local-first-engine-source-qualification.yml": [
      "pull_request"
    ],
    "malware-gate.yml": [
      "pull_request",
      "push",
      "workflow_dispatch",
      "schedule"
    ],
    "masterplan-421-dossier-integrity.yml": [
      "pull_request",
      "workflow_dispatch"
    ],
    "merge-readiness.yml": [
      "workflow_dispatch",
      "pull_request",
      "push"
    ],
    "queue-drain.yml": [
      "workflow_dispatch",
      "schedule",
      "push"
    ],
    "release-images.yml": [
      "push",
      "workflow_dispatch"
    ],
    "repository-hygiene-gate.yml": [
      "pull_request",
      "push"
    ],
    "reproducible-release.yml": [
      "push",
      "workflow_dispatch"
    ],
    "sealed-context-guard.yml": [
      "pull_request",
      "push",
      "workflow_dispatch"
    ],
    "secret-scanning.yml": [
      "pull_request",
      "push",
