{
  "schema_version": "skeleton.nfr_registry.v1",
  "registry_version": "0.1.0",
  "status": "active",
  "purpose": "Hard, reproducible P2 traceability quality budgets bound to VOL-123.",
  "nfrs": [
    {
      "id": "NFR-TRACE-REQ-COVERAGE",
      "claim": "Every P2 trace requirement is represented in the master trace graph",
      "metric": "requirement_trace_coverage",
      "operator": ">=",
      "threshold": 1,
      "unit": "ratio",
      "workload": "current P2-TRACE requirement registry",
      "environment": "repository exact head",
      "measurement": "scripts/check_p2_traceability.py"
    },
    {
      "id": "NFR-TRACE-DANGLING",
      "claim": "Trace graph contains no dangling edge endpoints",
      "metric": "dangling_trace_edges",
      "operator": "==",
      "threshold": 0,
      "unit": "count",
      "workload": "current master trace graph",
      "environment": "repository exact head",
      "measurement": "scripts/check_p2_traceability.py"
    },
    {
      "id": "NFR-CAP-VOLUME-COVERAGE",
      "claim": "Every masterplan volume has a capability-class mapping",
      "metric": "volume_taxonomy_coverage",
      "operator": ">=",
      "threshold": 1,
      "unit": "ratio",
      "workload": "all canonical masterplan volumes",
      "environment": "repository exact head",
      "measurement": "scripts/check_p2_traceability.py"
    },
    {
      "id": "NFR-SCHEMA-COVERAGE",
      "claim": "Every canonical runtime record is registered",
      "metric": "schema_registry_coverage",
      "operator": ">=",
      "threshold": 1,
      "unit": "ratio",
      "workload": "all ai_runtime_schemas records",
      "environment": "repository exact head",
      "measurement": "scripts/check_p2_traceability.py"
    },
    {
      "id": "NFR-IFACE-FAILURE-COVERAGE",
      "claim": "Every canonical interface edge has explicit failure semantics",
      "metric": "interface_failure_contract_coverage",
      "operator": ">=",
      "threshold": 1,
      "unit": "ratio",
      "workload": "all capability interface edges",
      "environment": "repository exact head",
      "measurement": "scripts/check_p2_traceability.py"
    }
  ],
  "policy": {
    "non_compensable": "Every NFR is hard-gated independently; averages cannot offset a failed NFR.",
    "reproducibility": "Metric, threshold, workload, environment and measurement implementation are explicit.",
    "claim_binding": "Production claims in this registry are identified by NFR ID."
  }
}
