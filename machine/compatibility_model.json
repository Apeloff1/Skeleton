{
  "schema_version": "skeleton.trace.compatibility_model.v1",
  "model_version": "0.1.0",
  "status": "active",
  "purpose": "Producer/consumer compatibility and mixed-version policy for canonical schemas and interfaces.",
  "masterplan_binding": {
    "volume_ref": "VOL-130",
    "title": "Compatibility Model",
    "required_gap_texts": [
      "bind schema/API versions to matrix",
      "define support window policy"
    ]
  },
  "sources": {
    "schemas": "machine/schema_registry.json",
    "interfaces": "machine/capability_interfaces.json",
    "guard": "skeleton/data/schema_evolution.py"
  },
  "support_window_policy": {
    "default_supported_versions": 2,
    "rule": "Current plus immediately preceding compatible version are supported unless a narrower explicit security policy applies.",
    "breaking_change_rule": "Breaking changes require version increment, migration order, rollback path, mixed-version behavior and deprecation window before landing.",
    "rollback_rule": "Writer changes may not remove the ability to roll back within the declared support window."
  },
