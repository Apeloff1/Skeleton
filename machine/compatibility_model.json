{
  "schema_version": "skeleton.compatibility_model.v1",
  "model_version": "0.1.0",
  "status": "active",
  "purpose": "Conservative mixed-version and rollback rules for P2 canonical schemas/interfaces.",
  "sources": {
    "schema_registry": "machine/schema_registry.json",
    "interface_registry": "machine/capability_interfaces.json"
  },
  "support_windows": [
    {
      "surface": "canonical_runtime_records",
      "producer_window": "current schema version",
      "consumer_window": "current unless explicit additive-optional reader policy",
      "rollback_required": true
    },
    {
      "surface": "capability_interfaces",
      "producer_window": "current registry contract",
      "consumer_window": "current registry contract",
      "rollback_required": true
    }
  ],
  "change_rules": [
    {
      "change": "add_optional_response_field",
      "classification": "conditionally_compatible",
      "requires": [
        "explicit optionality",
        "reader additive policy",
        "regression evidence"
      ]
    },
    {
      "change": "remove_field",
      "classification": "incompatible",
      "requires": [
        "migration plan",
        "rollback plan",
        "version bump"
      ]
    },
    {
      "change": "rename_field",
      "classification": "incompatible",
      "requires": [
        "migration plan",
        "rollback plan",
        "version bump"
      ]
    },
    {
      "change": "change_type_or_nullability",
      "classification": "incompatible",
      "requires": [
        "migration plan",
        "rollback plan",
        "version bump"
      ]
    },
    {
      "change": "add_closed_enum_value",
      "classification": "incompatible_until_consumer_evidence",
      "requires": [
        "mixed-version test",
        "fallback behavior",
        "version policy"
      ]
    },
    {
      "change": "authority_semantics",
      "classification": "incompatible",
      "requires": [
        "ADR",
        "migration plan",
        "rollback plan",
        "security review"
      ]
    }
  ],
  "policy": {
    "no_flag_day": "Incompatible cross-boundary changes may not assume simultaneous deployment.",
    "rollback_rule": "Every incompatible change needs explicit rollback before landing.",
    "unknown_rule": "Unclassified changes are incompatible by default."
  },
  "masterplan_binding": {
    "volume_ref": "VOL-130",
    "title": "Compatibility Model",
    "required_gap_texts": [
      "bind schema/API versions to matrix",
      "define support window policy"
    ]
  }
}
