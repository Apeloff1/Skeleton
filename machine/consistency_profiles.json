  "policy": {
    "domain_coverage": "Every machine/state_topology.json state_domain appears exactly once.",
    "authoritative_reads": "authoritative and conditional-authoritative domains reject stale and unknown reads",
    "projection_reads": "derived and durable-projection domains may serve stale state only with explicit caller opt-in; unknown remains blocked",
    "scratch_reads": "scratch state is never source-of-truth and stale use is explicit",
    "recovery_aids": "recovery-aid state is never a normal application read authority",
    "write_rule": "authoritative writes require durable commit acknowledgement; projections are source-first; scratch/recovery writes never become authority",
    "staleness_thresholds": "No numeric staleness threshold is invented. max_staleness_ms remains null until a domain-specific NFR supplies one."
  },
