    "native_registry": "skeleton/native/registry.py",
    "jvm_registry": "skeleton/native/jvm_registry.py"
  },
  "selection_policy": {
    "default_route": "reference",
    "evidence_required": true,
    "minimum_profile_runs": 2,
    "minimum_distinct_environment_ids": 1,
    "minimum_speedup": 1.2,
    "maximum_abs_error": 0.00001,
    "maximum_crashes": 0,
    "maximum_timeouts": 0,
    "source_identity_required": true,
    "non_compensable": [
      "correctness",
      "error tolerance",
      "source identity",
      "sample count",
      "speedup",
      "crash budget",
      "timeout budget",
      "fallback availability",
      "isolation requirement",
      "protocol compatibility"
    ]
  },
  "isolation_policy": {
    "low_risk": "in_process_allowed",
    "medium_risk": "subprocess_required_for_automatic_selection",
    "high_risk": "subprocess_required",
    "timeout_required": true,
    "bounded_output_required": true,
    "environment_allowlist_required": true,
    "fallback_on_isolation_failure": true
  },
  "protocol_policy": {
    "protocol_id": "skeleton.acceleration.rpc",
    "supported_versions": [
      "1.0"
    ],
    "negotiation": "highest exact shared version",
    "unknown_version": "reject",
    "request_id_required": true,
    "operation_required": true,
    "deadline_required": true,
    "fallback_on_negotiation_failure": true
  },
