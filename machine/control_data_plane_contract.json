  "cross_role_policy": {
    "raw_payload_into_control_forbidden": true,
    "cross_role_reference_only": true,
    "data_to_control_operations": [
      "admission.request",
      "evidence.report",
      "policy.query"
    ],
    "control_to_data_operations": [
      "authority.decision",
      "configuration.reference",
      "execution.permit"
    ],
    "control_to_data_requires_authority_receipt": true,
    "unknown_plane_fails_closed": true
  },
  "invariants": [
    "every canonical construction plane is classified exactly once",
    "classification is derived from the architecture execution profile",
    "policy evidence and release control profiles are control-plane roles",
    "all other runtime execution profiles are data-plane roles",
    "raw tenant payloads never cross into a control-plane role",
    "data-to-control calls are bounded metadata/reference requests only",
    "control-to-data authority changes carry an exact authority receipt digest",
    "unknown planes and unknown cross-role operations fail closed"
  ]
}
