{
  "schema_version": "skeleton.maintenance_ownership.v1",
  "registry_version": "0.1.0",
  "status": "active",
  "purpose": "Canonical ownership/risk classes and fail-closed deletion preconditions for repository maintenance.",
  "masterplan_binding": {
    "volume_ref": "VOL-092",
    "title": "Repository Maintenance",
    "required_gap_texts": []
  },
  "roots": [
    {
      "root_id": "product-shell",
      "path": "frontend",
      "owner": "human-interface",
      "class": "runtime",
      "change_lane": "ui",
      "deletion_risk": "high",
      "automated_delete_allowed": false
    },
    {
      "root_id": "application-api",
      "path": "backend",
      "owner": "application-api",
      "class": "runtime",
      "change_lane": "api",
      "deletion_risk": "high",
      "automated_delete_allowed": false
    },
    {
      "root_id": "engine-runtime",
      "path": "skeleton",
      "owner": "engine",
      "class": "runtime",
      "change_lane": "engine",
      "deletion_risk": "high",
      "automated_delete_allowed": false
    },
    {
      "root_id": "java-accelerators",
      "path": "java-accelerators",
      "owner": "engine",
      "class": "accelerator",
      "change_lane": "accelerator",
      "deletion_risk": "high",
      "automated_delete_allowed": false
    },
    {
      "root_id": "machine-control",
      "path": "machine",
      "owner": "repository-machine",
      "class": "control",
      "change_lane": "machine",
      "deletion_risk": "critical",
      "automated_delete_allowed": false
    },
    {
      "root_id": "automation",
      "path": ".github",
      "owner": "repository-automation",
      "class": "control",
      "change_lane": "automation",
      "deletion_risk": "critical",
      "automated_delete_allowed": false
    },
    {
      "root_id": "operator-tooling",
      "path": "scripts",
      "owner": "operators",
      "class": "tooling",
      "change_lane": "tooling",
      "deletion_risk": "high",
      "automated_delete_allowed": false
    },
    {
      "root_id": "documentation",
      "path": "docs",
      "owner": "architecture",
      "class": "documentation",
      "change_lane": "docs",
      "deletion_risk": "high",
      "automated_delete_allowed": false
    }
  ],
  "protected_artifact_classes": [
    {
      "id": "accountability_evidence",
      "patterns": [
        "machine/accountability_events/**",
        "machine/ai_build_accountability.json"
      ],
      "rule": "never delete through generic maintenance"
    },
    {
      "id": "active_migration",
      "patterns": [
        "machine/repository_migration_plan.json",
        "satellites/branch-snapshots/**"
      ],
      "rule": "requires migration-specific reachability and retention disposition"
    },
    {
      "id": "release_evidence",
      "patterns": [
        "machine/p1_release_*.json",
        "docs/RELEASE_SECURITY_EVIDENCE.md"
      ],
      "rule": "requires release-retention disposition"
    },
    {
      "id": "planning_authority",
      "patterns": [
        "machine/ai_*.json",
        "docs/plan/**"
      ],
      "rule": "requires canonical replacement and trace-impact proof before deletion"
    },
    {
      "id": "workflow_authority",
      "patterns": [
        ".github/workflows/**"
      ],
      "rule": "requires workflow reachability and branch-protection impact proof before deletion"
    }
  ],
  "deletion_preconditions": [
    "canonical owner identified",
    "reachability evidence proves no live runtime/build/workflow/trace consumer",
    "retention policy disposition exists",
    "migration/generated/release/evidence class disposition exists when applicable",
    "rollback or restore reference exists",
    "exact candidate path is bounded and non-symlink",
    "deletion receipt records source HEAD and validator evidence"
  ],
  "stale_resource_policy": {
    "branch": "stale age alone is insufficient; merged/reachable/unmerged state and retained evidence must be checked",
    "file": "no deletion on filename, age or duplicate heuristic alone",
    "dependency": "remove only after import/build/runtime reachability check and lockfile reconciliation"
  }
}
