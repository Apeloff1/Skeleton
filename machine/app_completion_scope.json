{
  "schema": "skeleton.ai.app_completion_scope.v1",
  "title": "Skeleton full application functional completion measurement",
  "scope": "42 audited product families; not an exhaustive individual feature enumeration",
  "version": "2026-10-13",
  "denominator_policy": "equal-weight families; five independent evidence stages per family; missing evidence unknown, never passed",
  "stages": [
    {
      "id": "source_owner",
      "definition": "canonical owner source exists; static only",
      "source_auto_measure": true
    },
    {
      "id": "implementation_test",
      "definition": "targeted exact-head test run independently verified",
      "source_auto_measure": false
    },
    {
      "id": "runtime_integration",
      "definition": "real running integrated engine/API/DB test passed",
      "source_auto_measure": false
    },
    {
      "id": "user_journey",
      "definition": "representative real user outcome with durable state and no stubs",
      "source_auto_measure": false
    },
    {
      "id": "release_device",
      "definition": "installed device + security/performance/recovery/rollback qualified",
      "source_auto_measure": false
    }
  ],
  "evidence_policy": {
    "source_presence_is_not_functionality": true,
    "unknown_must_remain_unknown": true,
    "never_infer_ci_from_workflow_file": true,
    "never_promote_planned_volume_signatures": true,
    "independent_evidence_required": true,
    "regression_invalidates_accepted_receipts": true
  },
  "families": [
    {
      "id": "F01",
