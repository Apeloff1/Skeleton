{
  "schema_version": "skeleton.architecture.python_package_layers.v1",
  "manifest_version": "0.3.0",
  "status": "active",
  "purpose": "Masterplan-bound Python package layering for high-risk Skeleton packages, with deterministic import-edge validation.",
  "masterplan_bindings": [
    {
      "volume_ref": "VOL-052",
      "title": "Internal Python Architecture",
      "required_gap_texts": [
        "define package layer manifest",
        "add import graph fitness test"
      ]
    },
    {
      "volume_ref": "VOL-053",
      "title": "Import Architecture",
      "required_gap_texts": [
        "remove remaining path hacks",
        "materialize packaged-wheel import test"
      ]
    }
  ],
  "policy": {
    "scope": "selected_high_risk",
    "unclassified_internal_imports": "allowed_but_reported",
    "same_layer_imports": true,
    "rule": "A classified source may import the same layer or a lower-numbered layer only. Unclassified internal modules do not create permission to import a known higher layer.",
    "path_hack_rule": "Classified production modules must not mutate sys.path or PYTHONPATH at runtime.",
    "package_rule": "Every declared package/path must exist under skeleton/. Nested declarations are permitted; the longest matching path owns each classified source module.",
    "compatibility_facade_rule": "Lower-layer package __init__ modules may preserve historical higher-layer exports only through explicit lazy importlib-based __getattr__ facades; eager upward imports remain forbidden and lazy names are compatibility surfaces, not dependency permission."
  },
  "layers": [
    {
      "id": "PY-L0",
      "order": 0,
      "name": "foundation",
      "paths": [
        "skeleton/kernel"
      ],
      "allowed_layer_ids": [
        "PY-L0"
      ],
      "forbidden_external_roots": [
        "fastapi",
        "flask",
        "django",
        "requests",
        "httpx",
        "sqlalchemy",
        "psycopg",
        "psycopg2",
        "pymongo",
