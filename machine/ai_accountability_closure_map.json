{
  "schema_version": 1,
  "map_version": "1.0.0",
  "status": "active",
  "objective": "Map every atomic AI build queue task to one closed canonical gap and one independent exact-head verification gate before any accountability sign-off or completion.",
  "rules": {
    "queue_task_count": 42,
    "tasks_per_group": 3,
    "require_closed_gap": true,
    "require_closed_handoff": true,
    "require_closed_closure_evidence": true,
    "require_exact_head_gate": true,
    "require_distinct_verification_signer": true,
    "mutation_policy": "This map and its verifier never mutate ai_build_accountability.json. Sign-off remains a separate signed lifecycle action."
  },
  "groups": [
    {
      "key": "S0-STATE",
      "stage": 0,
      "task_prefix": "AIQ-S0-STATE-",
      "gap_id": "gap-state-authority-convergence",
      "workflow": ".github/workflows/state-recovery-drill.yml",
      "workflow_name": "State Recovery Drill",
      "verifier_script": "scripts/verify_state_authority_closure.py",
      "expected_receipt_verifier": "independent-state-authority-v1"
    },
    {
      "key": "S0-GOV",
      "stage": 0,
      "task_prefix": "AIQ-S0-GOV-",
      "gap_id": "gap-governance-registry",
      "workflow": ".github/workflows/governance-closure.yml",
      "workflow_name": "Governance Closure Gate",
      "verifier_script": "scripts/verify_governance_closure.py",
      "expected_receipt_verifier": "independent-governance-v1"
    },
    {
      "key": "S0-COST",
      "stage": 0,
      "task_prefix": "AIQ-S0-COST-",
      "gap_id": "gap-cost-admission",
      "workflow": ".github/workflows/cost-admission-closure.yml",
      "workflow_name": "Cost Admission Closure Gate",
      "verifier_script": "scripts/verify_cost_admission_closure.py",
      "expected_receipt_verifier": "independent-cost-admission-v1"
    },
    {
      "key": "S0-PROV",
      "stage": 0,
      "task_prefix": "AIQ-S0-PROV-",
      "gap_id": "gap-provider-surface-convergence",
      "workflow": ".github/workflows/provider-surface-closure.yml",
      "workflow_name": "Provider Surface Closure Gate",
      "verifier_script": "scripts/verify_provider_surface_closure.py",
      "verifier_binding_token": "provider_surface_convergence_blueprint",
      "expected_receipt_verifier": "independent-provider-surface-v1"
    },
    {
      "key": "S1-CONV",
