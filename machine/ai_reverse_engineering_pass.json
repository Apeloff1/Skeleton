  "global_reverse_constraints": [
    {
      "id": "RC-01",
      "name": "bootstrap_closure",
      "rule": "Later-stage services may not be the sole means of proving an early authority/runtime invariant."
    },
    {
      "id": "RC-02",
      "name": "independent_verifier_separation",
      "rule": "A target that can mutate side effects, policy, promotion, or completion may not be its own sole verifier in the same transaction."
    },
    {
      "id": "RC-03",
      "name": "restart_equivalence",
      "rule": "Durable workflow success before and after restart must converge to equivalent authoritative terminal state."
    },
    {
      "id": "RC-04",
      "name": "unknown_outcome_handling",
      "rule": "Commit-before-ack external effects require idempotency, reconciliation, or explicit unknown/recovery semantics; blind retry is forbidden."
    },
    {
      "id": "RC-05",
      "name": "promotion_barrier",
      "rule": "Construction overlap never implies promotion overlap; production promotion waits for the complete reverse proof chain."
    },
    {
      "id": "RC-06",
      "name": "migration_symmetry",
      "rule": "State-changing migrations name forward, rollback and mixed-version behavior or a tested forward-recovery-only disposition."
    },
    {
      "id": "RC-07",
      "name": "projection_humility",
      "rule": "Caches, indexes, vectors, streams, dashboards, UI state and model context are projections unless a canonical contract explicitly says otherwise."
    },
    {
      "id": "RC-08",
      "name": "negative_space_proof",
      "rule": "Every high-impact capability proves at least one important forbidden outcome cannot occur."
    }
  ],
