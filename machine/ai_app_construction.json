{
  "schema_version": 1,
  "construction_version": "2.0.0",
  "architecture_tag": "arch-map/v2.0",
  "status": "active",
  "title": "Skeleton SOTA AI Application Construction Contract",
  "purpose": "Canonical machine-readable build manual for constructing, assembling, validating, operating, and evolving the complete AI application without architecture gaps.",
  "human_manual": "docs/AI_APP_CONSTRUCTION_MANUAL.md",
  "architecture_contract": "machine/architecture.json",
  "runtime_contract": "skeleton/app/manifest.json",
  "provider_bootstrap": {
    "mandatory": true,
    "mode": "fail_closed",
    "rule": "Every AI development agent and every runtime model provider activation must load the active architecture and construction contracts before changing or serving the system.",
    "must_read": [
      "machine/manifest.json",
      "machine/architecture.json",
      "machine/ai_app_construction.json",
      "docs/AI_APP_CONSTRUCTION_MANUAL.md"
    ],
    "development_provider_entrypoints": [
      {
        "provider": "generic",
        "path": "AGENTS.md",
        "required": true
      },
      {
        "provider": "anthropic-claude",
        "path": "CLAUDE.md",
        "required": true
      },
      {
        "provider": "github-copilot",
        "path": ".github/copilot-instructions.md",
        "required": true
      },
      {
        "provider": "cursor",
        "path": ".cursor/rules/architecture.mdc",
        "required": true
      }
    ],
    "runtime_enforcement": {
      "loader": "backend/core/provider_architecture.py",
      "activation_boundary": "backend/core/ai_provider.py",
      "docker_materialization": "backend/Dockerfile",
      "receipt_required": true,
      "undeclared_provider_policy": "deny"
    }
  },
  "quality_attributes": {
    "correctness": "Contract-first boundaries, deterministic validators, typed provider-neutral interfaces, evidence-backed release gates.",
    "availability": "Bounded retries, circuit breaking, graceful degradation, durable checkpoints, provider failover, recovery drills.",
    "latency": "Fast-path routing, streaming, caches, async I/O, parallel validation, isolated accelerators, budget-aware model selection.",
    "security": "Least privilege, sealed secrets, SSRF-safe provider endpoints, input/output bounds, sandboxed tools, auditable authority.",
    "privacy": "Explicit data classes, minimization, retention/deletion policy, tenant isolation, provider privacy ceilings.",
    "observability": "Request/trace correlation, structured logs, metrics, cost/latency/quality telemetry, SLOs and evidence receipts.",
    "evolvability": "Canonical owners, adapters before migrations, capability contracts, compatibility windows, architecture drift gates."
  },
  "build_principles": [
    "contract before implementation",
    "one canonical owner per capability",
    "provider-neutral core with provider-specific adapters at the edge",
    "fail closed on authority, secrets, provider registration, architecture drift, and destructive actions",
    "bounded resource usage at every untrusted boundary",
    "durability before autonomy",
    "observability before optimization",
    "evaluation before promotion",
    "fallback before acceleration",
    "migration by domain and interface, never by blind history merge"
  ],
  "planes": [
