  "vectors": [
    {
      "id": "JSON-DUPLICATE-KEY",
      "kind": "raw_json",
      "payload": "{\"a\":1,\"a\":2}",
      "expected": "reject",
      "reason": "duplicate keys are ambiguous"
    },
    {
      "id": "JSON-NAN",
      "kind": "raw_json",
      "payload": "{\"a\":NaN}",
      "expected": "reject",
      "reason": "non-finite numbers are not canonical JSON"
    },
    {
      "id": "JSON-INFINITY",
      "kind": "raw_json",
      "payload": "{\"a\":Infinity}",
      "expected": "reject",
      "reason": "non-finite numbers are not canonical JSON"
    },
    {
      "id": "JSON-NEG-INFINITY",
      "kind": "raw_json",
      "payload": "{\"a\":-Infinity}",
      "expected": "reject",
      "reason": "non-finite numbers are not canonical JSON"
    },
    {
      "id": "JSON-UNICODE-ROUNDTRIP",
      "kind": "raw_json",
      "payload": "{\"text\":\"Ångström — 東京 — 😀\"}",
      "expected": "accept",
      "reason": "UTF-8 Unicode round-trips without authority changes"
    },
    {
      "id": "SCHEMA-ABSENT-REQUIRED",
      "kind": "schema_edge",
      "record": "OperationEnvelope",
      "mutation": "remove:operation_id",
      "expected": "reject",
      "reason": "required fields cannot be absent"
    },
    {
      "id": "SCHEMA-NULL-NONNULLABLE",
      "kind": "schema_edge",
      "record": "OperationEnvelope",
      "mutation": "null:operation_id",
      "expected": "reject",
      "reason": "non-nullable fields reject explicit null"
    },
    {
      "id": "SCHEMA-UNKNOWN-ENUM",
      "kind": "schema_edge",
      "record": "OperationEnvelope",
      "mutation": "enum:state=__unknown__",
      "expected": "reject",
      "reason": "closed enum values fail closed"
    },
    {
      "id": "SCHEMA-NULL-NULLABLE",
      "kind": "schema_edge",
      "record": "OperationEnvelope",
      "mutation": "null:deadline",
      "expected": "accept",
      "reason": "declared nullable fields accept explicit null"
    }
  ]
