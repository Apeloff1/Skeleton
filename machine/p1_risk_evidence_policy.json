    },
    "volume_gap": {
      "kind": "gap",
      "default_severity": "high",
      "blocking_by_default": true,
      "rule": "Explicit P1 masterplan gaps are blocking until evidence-bound or signed/time-bounded accepted risk."
    },
    "adversarial_axis": {
      "kind": "adversarial",
      "default_severity": "high",
      "blocking_by_default": true,
      "rule": "Applicable cross-condition adversarial obligations are blocking until evidence-bound or signed/time-bounded accepted risk."
    }
  },
  "binding_rules": {
    "owner_required": true,
    "explicit_severity_required": true,
