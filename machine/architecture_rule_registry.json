  "registry_policy": {
    "discovery_rule": "Every scripts/check_architecture*.py validator plus the AI file-tree and scope-freeze architecture guards must have exactly one registry rule.",
    "owner_rule": "Every rule must bind to one or more canonical root IDs from machine/architecture.json.",
    "change_control_rule": "Every rule declares change_requires_adr=true. A waiver additionally requires an existing ADR document and bounded evidence.",
    "waiver_rule": "Waivers are optional per rule, never permanent, never wildcard, and fail closed at or after expires_at_utc.",
    "execution_rule": "When invoked with --execute, the registry runs every registered validator except itself in deterministic rule-id order; any non-zero result fails the aggregate gate without converting success into maturity evidence.",
    "execution_order": "sorted rule id; registry self-check excluded to prevent recursion"
  },
