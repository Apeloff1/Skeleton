    {
      "id": "MBW-00",
      "name": "Authority, Contracts & Semantic Bedrock",
      "hard_dependencies": [],
      "overlap_allowed_with": [
        "MBW-01"
      ],
      "work_package_refs": [
        "WP-W00",
        "WP-W01"
      ],
      "stop_conditions": [
        "human and machine plan disagree on identity or breadth",
        "security-sensitive parsing remains permissive or ambiguous",
        "a contract change lacks compatibility/migration semantics"
      ],
      "definition_of_done": [
        "canonical contracts have explicit version/compatibility semantics",
        "security-sensitive encodings fail closed",
        "W00/W01 evidence is linked from the signed ledger"
      ]
    },
    {
      "id": "MBW-01",
      "name": "Runtime Spine, Durable State & Recovery",
      "hard_dependencies": [
        "MBW-00"
      ],
      "overlap_allowed_with": [
        "MBW-02",
        "MBW-03"
      ],
      "work_package_refs": [
        "WP-W02",
        "WP-W03",
        "WP-W04",
        "WP-W19"
      ],
      "stop_conditions": [
        "derived stores become authoritative by convenience",
        "retries can duplicate committed effects",
        "backup exists without a verified restore path"
      ],
      "definition_of_done": [
        "boot/shutdown/restart are deterministic",
        "authoritative restore and projection rebuild are proven",
        "event replay is idempotent and side-effect safe"
      ]
    },
    {
      "id": "MBW-02",
      "name": "Model, Memory, Retrieval, Knowledge & Context",
      "hard_dependencies": [
        "MBW-00",
        "MBW-01"
      ],
      "overlap_allowed_with": [
        "MBW-03"
      ],
      "work_package_refs": [
        "WP-W05",
        "WP-W06",
        "WP-W07",
        "WP-W08",
        "WP-W09",
        "WP-W10"
      ],
      "stop_conditions": [
        "provider SDK objects leak into durable core state",
        "context truncation can remove immutable policy before untrusted content",
        "memory writes bypass governance or provenance"
      ],
      "definition_of_done": [
        "provider routing preserves policy/privacy constraints",
        "memory and retrieval writes are governed",
        "context compilation preserves trust under pressure"
      ]
    },
    {
      "id": "MBW-03",
      "name": "Privileged Action, Policy, Verification & Security",
      "hard_dependencies": [
        "MBW-00",
        "MBW-01"
      ],
      "overlap_allowed_with": [
        "MBW-02"
      ],
      "work_package_refs": [
        "WP-W13",
        "WP-W14",
        "WP-W17",
        "WP-W20"
      ],
      "stop_conditions": [
        "model output directly authorizes a privileged action",
        "tool execution lacks idempotency/compensation semantics",
        "network/filesystem normalization happens after authorization"
      ],
      "definition_of_done": [
        "privileged actions require deterministic authorization",
        "postconditions and receipts bind effects to operations",
        "critical filesystem/network/process cases have executable evidence"
      ]
    },
    {
      "id": "MBW-04",
      "name": "Cognition, Planning, Agents & Swarms",
      "hard_dependencies": [
        "MBW-02",
        "MBW-03"
      ],
      "overlap_allowed_with": [
        "MBW-06"
      ],
      "work_package_refs": [
        "WP-W11",
        "WP-W12",
        "WP-W15",
        "WP-W16"
      ],
      "stop_conditions": [
        "agent role text is treated as authority",
        "plan executor can bypass tool/policy gates",
        "checkpoint replay can repeat external side effects"
      ],
      "definition_of_done": [
        "cognitive loops are bounded and recoverable",
        "plan DAGs enforce pre/postconditions",
        "agent delegation, leases and conflicts are mechanically constrained"
      ]
    },
    {
      "id": "MBW-05",
      "name": "Observability, API, Product & Desktop",
      "hard_dependencies": [
        "MBW-01",
        "MBW-03",
        "MBW-04"
      ],
      "overlap_allowed_with": [
        "MBW-06"
      ],
      "work_package_refs": [
        "WP-W21",
        "WP-W22",
        "WP-W23",
        "WP-W24"
      ],
      "stop_conditions": [
        "frontend optimistic state becomes canonical",
        "stream replay lacks gap detection/resync",
        "desktop path/process behavior is only tested on one platform"
      ],
      "definition_of_done": [
        "reconnect/replay/resync is deterministic",
        "UI is projection-only",
        "operator-visible progress, cost, evidence and cancellation match durable state"
      ]
    },
    {
      "id": "MBW-06",
      "name": "Evaluation, Research, Forge & Controlled Learning",
      "hard_dependencies": [
        "MBW-02",
        "MBW-03",
        "MBW-04"
      ],
      "overlap_allowed_with": [
        "MBW-05"
      ],
      "work_package_refs": [
        "WP-W18",
        "WP-W26",
        "WP-W27",
        "WP-W28"
      ],
      "stop_conditions": [
        "production policy/model/config can be mutated directly by an experiment",
        "benchmark result lacks environment/version/budget provenance",
        "learning signal is treated as ground truth without validation"
      ],
      "definition_of_done": [
        "benchmarks are versioned and contamination-aware",
        "research claims preserve replication/negative-result lineage",
        "candidate promotion requires champion/challenger, canary and rollback evidence"
      ]
    },
    {
      "id": "MBW-07",
      "name": "Installer, Distributed Runtime & Production Hardening",
      "hard_dependencies": [
        "MBW-05",
        "MBW-06"
      ],
      "overlap_allowed_with": [],
      "work_package_refs": [
        "WP-W25",
        "WP-W29",
        "WP-W30"
      ],
      "stop_conditions": [
        "release depends on undocumented machine state",
        "rollback cannot read the post-upgrade data shape",
        "distributed placement ignores fencing/backpressure or hard resource limits",
        "critical unresolved risk is hidden by aggregate green status"
      ],
      "definition_of_done": [
        "clean-machine install/update/rollback is proven",
        "distributed execution survives failover/congestion/resource pressure",
        "release evidence, provenance, SLO/capacity and recovery artifacts are complete"
      ]
    }
