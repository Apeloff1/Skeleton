{
  "schema_version": "skeleton.ai.system_completion_contract.v1",
  "status": "active",
  "purpose": "Fail-closed, non-compensable system completion contract for standalone AI/SI. Completion requires all cross-cutting proofs on one exact source revision; subsystem success cannot compensate for another missing plane.",
  "required_requirements": [
    "execution.local_model",
    "execution.offline_isolation",
    "execution.request_result_binding",
    "execution.budget_bounds",
    "execution.stop_semantics",
    "execution.tool_authority",
    "execution.durable_recovery",
    "execution.staged_finalization_recovery",
    "execution.replay_lineage",
    "execution.reproducibility",
    "execution.governed_effects",
    "verification.independent",
    "verification.claim_binding",
    "context.integrity",
    "memory.lifecycle",
    "finalization.lineage",
    "learning.promotion",
    "learning.rollback"
  ],
  "authority": {
    "producer_must_differ_from_verifier": true,
    "exact_subject_binding": true,
    "exact_source_revision_binding": true,
    "duplicate_proofs_forbidden": true,
    "missing_proofs_fail_closed": true,
    "failed_proofs_non_compensable": true,
    "proof_source_revision_binding": true,
    "cross_execution_evidence_mixing_forbidden": true,
    "verification_candidate_context_binding": true,
    "learning_evaluation_lineage_required": true,
    "evidence_source_execution_binding": true,
    "learning_result_binding_required": true,
    "qualification_receipt_rehash_required": true,
    "strict_json_receipt_verification": true,
    "staged_finalization_crash_recovery_required": true,
    "negative_learning_gate_qualification_required": true
  },
  "runtime_binding": "skeleton/ai/runtime/system_completion.py",
  "acceptance_bindings": [
    "skeleton/testing/test_ai_system_completion_plane.py",
    "tests/test_ai_system_completion_verifier.py",
    "scripts/verify_ai_system_completion.py",
    ".github/workflows/ai-system-completion.yml",
    "skeleton/ai/evaluation/system_qualification.py",
    "scripts/run_ai_system_completion_qualification.py",
    "tests/test_ai_system_qualification.py",
    "scripts/verify_ai_system_qualification_receipt.py",
    "tests/test_ai_system_qualification_receipt_verifier.py"
  ],
  "inherited_proofs": [
    {
      "requirement": "execution.local_model",
      "source": "skeleton/ai/runtime/functional_ai.py",
      "acceptance": "skeleton/testing/test_vs001_functional_ai.py"
    },
    {
      "requirement": "execution.governed_effects",
      "source": "skeleton/intelligence/execution_runtime.py",
      "acceptance": "skeleton/testing/test_ai_effectiveness.py",
      "note": "When the effectiveness lane is present, mutable effects must carry observed postconditions. The system-completion plane independently refuses count mismatch."
    },
    {
      "requirement": "learning.promotion",
      "source": "skeleton/ai/learning/promotion.py",
      "acceptance": "skeleton/testing/test_vs005_self_improvement.py"
    }
  ],
  "completion_rule": "valid iff all 18 requirements pass for one subject and exact git revision; source evidence must belong to that execution; staged finalization must survive close/reopen and clear after recovery; verification binds exact candidate/context; memory binds owner; learning binds the qualified result and proves rejection of invalid promotion/rollback paths; emitted JSON independently rehashes under strict duplicate-key rejection",
  "qualification_binding": "skeleton/ai/evaluation/system_qualification.py",
  "qualification_cli": "scripts/run_ai_system_completion_qualification.py",
  "qualification_receipt_verifier": "scripts/verify_ai_system_qualification_receipt.py"
}
