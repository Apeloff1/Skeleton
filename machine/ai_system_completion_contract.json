{
  "schema_version": "skeleton.ai.system_completion_contract.v1",
  "status": "active",
  "purpose": "Fail-closed, non-compensable system completion contract for standalone AI/SI. Completion requires all cross-cutting proofs on one exact source revision; subsystem success cannot compensate for another missing plane.",
  "required_requirements": [
    "execution.local_model",
    "execution.offline_isolation",
    "execution.request_result_binding",
    "execution.budget_bounds",
    "execution.stop_semantics",
    "execution.tool_authority",
    "execution.durable_recovery",
    "execution.staged_finalization_recovery",
    "persistence.terminal_evidence_integrity",
    "execution.replay_lineage",
    "execution.reproducibility",
    "execution.governed_effects",
    "verification.independent",
    "verification.claim_binding",
    "verification.receipt_identity",
    "context.integrity",
    "memory.lifecycle",
    "finalization.lineage",
    "finalization.outbox_delivery",
    "learning.promotion",
    "learning.rollback",
    "security.sandbox_filesystem",
    "security.sandbox_process",
    "security.injection_sanitization",
    "privacy.provider_fallback",
    "memory.poisoning_resistance",
    "security.outbound_network_boundary",
    "resource.admission_quota",
    "resource.unknown_usage_fence",
    "resource.shared_pressure",
    "execution.idempotent_retry",
    "privacy.tenant_isolation"
  ],
  "authority": {
    "producer_must_differ_from_verifier": true,
    "exact_subject_binding": true,
    "exact_source_revision_binding": true,
    "duplicate_proofs_forbidden": true,
    "missing_proofs_fail_closed": true,
    "failed_proofs_non_compensable": true,
    "proof_source_revision_binding": true,
    "cross_execution_evidence_mixing_forbidden": true,
    "verification_candidate_context_binding": true,
    "learning_evaluation_lineage_required": true,
    "evidence_source_execution_binding": true,
    "learning_result_binding_required": true,
    "qualification_receipt_rehash_required": true,
    "strict_json_receipt_verification": true,
    "staged_finalization_crash_recovery_required": true,
    "negative_learning_gate_qualification_required": true,
    "sandbox_boundary_qualification_required": true,
    "injection_sanitization_qualification_required": true,
    "provider_privacy_fallback_qualification_required": true,
    "memory_poisoning_resistance_required": true,
    "outbound_network_boundary_qualification_required": true,
    "qualification_semantic_reverification_required": true,
    "resource_admission_qualification_required": true,
    "shared_pressure_qualification_required": true,
    "idempotent_retry_qualification_required": true,
    "tenant_isolation_qualification_required": true,
    "unknown_usage_terminal_fence_required": true,
    "verification_receipt_identity_required": true,
    "terminal_outbox_delivery_required": true,
    "persisted_terminal_evidence_integrity_required": true,
    "persisted_replay_evidence_integrity_required": true,
    "append_only_state_journal_required": true
  },
  "runtime_binding": "skeleton/ai/runtime/system_completion.py",
  "acceptance_bindings": [
    "skeleton/testing/test_ai_system_completion_plane.py",
    "tests/test_ai_system_completion_verifier.py",
    "scripts/verify_ai_system_completion.py",
    ".github/workflows/ai-system-completion.yml",
    "skeleton/ai/evaluation/system_qualification.py",
    "scripts/run_ai_system_completion_qualification.py",
    "tests/test_ai_system_qualification.py",
    "scripts/verify_ai_system_qualification_receipt.py",
    "tests/test_ai_system_qualification_receipt_verifier.py"
  ],
  "inherited_proofs": [
    {
      "requirement": "execution.local_model",
      "source": "skeleton/ai/runtime/functional_ai.py",
      "acceptance": "skeleton/testing/test_vs001_functional_ai.py"
    },
    {
      "requirement": "execution.governed_effects",
      "source": "skeleton/intelligence/execution_runtime.py",
      "acceptance": "skeleton/testing/test_ai_effectiveness.py",
      "note": "When the effectiveness lane is present, mutable effects must carry observed postconditions. The system-completion plane independently refuses count mismatch."
    },
    {
      "requirement": "learning.promotion",
      "source": "skeleton/ai/learning/promotion.py",
      "acceptance": "skeleton/testing/test_vs005_self_improvement.py"
    }
  ],
  "completion_rule": "valid iff all 32 non-compensable requirements pass for one subject and exact git revision; request, mutable state, hash-chained state history, turns, checkpoints, terminal results, verification receipts, outbox events, crash recovery, accounting fences, sandbox/privacy/network/resource/tenant boundaries, learning lineage, and emitted receipt evidence must remain causally bound, integrity-checked in persistence, and independently reverified for both digest and semantic correctness",
  "qualification_binding": "skeleton/ai/evaluation/system_qualification.py",
  "qualification_cli": "scripts/run_ai_system_completion_qualification.py",
  "qualification_receipt_verifier": "scripts/verify_ai_system_qualification_receipt.py",
  "inherited_security_bindings": [
    "skeleton/ai/runtime/sandbox/fs.py",
    "skeleton/ai/runtime/sandbox/process.py",
    "skeleton/ai/runtime/sandbox/injection.py",
    "skeleton/ai/runtime/sandbox/sanitizers.py",
    "skeleton/ai/shell/model_port.py",
    "skeleton/ai/shell/provider_router.py",
    "skeleton/memory/policy.py",
    "skeleton/memory/writeback.py",
    "skeleton/security/outbound_url.py",
    "skeleton/security/outbound_http.py",
    "skeleton/testing/test_sandbox_isolation.py",
    "skeleton/testing/test_sandbox_sanitize_inject.py",
    "skeleton/testing/test_shell_ai_observation_metrics_audit.py",
    "skeleton/testing/test_memory_writeback.py",
    "skeleton/testing/test_outbound_url_resolution_security.py",
    "skeleton/testing/test_security_outbound_http.py",
    ".github/workflows/p0-provider-fallback-privacy.yml",
    ".github/workflows/p0-memory-poisoning-evidence.yml",
    ".github/workflows/p0-network-boundary-evidence.yml",
    "skeleton/intelligence/admission.py",
    "skeleton/intelligence/admission_runtime.py",
    "skeleton/intelligence/quota.py",
    "skeleton/intelligence/shared_pressure.py",
    "skeleton/persistence/memory_repository.py",
    "skeleton/testing/test_admission_runtime.py",
    "skeleton/testing/test_execution_repository.py",
    "skeleton/persistence/execution_repository.py"
  ]
}
