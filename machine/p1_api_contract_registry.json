{
  "schema_version": 1,
  "registry_version": "1.0.0",
  "task_id": "P1-PROD-01",
  "accountability_ref": "ACC-P1-PROD-01",
  "scope": {
    "kind": "route_module",
    "route_module": "backend/routes/operation_stream.py",
    "mount_prefix": "/api",
    "router_prefix": "/operations",
    "require_complete_decorator_inventory": true,
    "route_registry_module": "backend/core/routes_registry.py",
    "route_import": "routes.operation_stream"
  },
  "conventions": {
    "schema_refs": "Names resolve against machine/ai_runtime_schemas.json records and are hashed as canonical JSON.",
