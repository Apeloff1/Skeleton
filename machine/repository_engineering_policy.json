{
  "schema_version": "skeleton.repository_engineering_policy.v1",
  "policy_version": "0.1.0",
  "status": "active",
  "purpose": "Bind autonomous repository mutation to inspect→plan→lease→edit→build→test→review→verify with transactional workspace and independent verification.",
  "masterplan_binding": {
    "volume_ref": "VOL-022",
    "title": "Autonomous Repository Engineering",
    "required_gap_texts": []
  },
  "phases": [
    {
      "order": 1,
      "id": "inspect",
      "authority": [
        "skeleton/automation/backlog_index.py",
        "skeleton/repo_machine/model.py",
        "machine/repository_graph_contract.json"
      ]
    },
    {
      "order": 2,
      "id": "plan",
      "authority": [
        "skeleton/repo_machine/planner.py",
        "skeleton/repo_machine/workgraph.py",
        "machine/master_traceability.json"
      ]
    },
    {
      "order": 3,
      "id": "lease",
      "authority": [
        "skeleton/shells/workspace_txn/lease.py",
        "skeleton/shells/leases.py"
      ]
    },
    {
      "order": 4,
      "id": "edit",
      "authority": [
        "skeleton/shells/workspace_txn/transaction.py",
        "skeleton/shells/workspace_txn/journal.py"
      ]
    },
    {
      "order": 5,
      "id": "build",
      "authority": [
        "skeleton/shells/workspace_txn/verify.py"
      ]
    },
    {
      "order": 6,
      "id": "test",
      "authority": [
        "skeleton/shells/workspace_txn/verify.py",
        "machine/ai_engineering_task_matrix.json"
      ]
    },
    {
      "order": 7,
      "id": "review",
      "authority": [
        "machine/ai_build_accountability.json",
        "machine/master_traceability.json"
      ]
    },
    {
      "order": 8,
      "id": "verify",
      "authority": [
        "machine/ai_build_accountability.json",
        "scripts/check_p2_repository_control.py"
      ]
    }
  ],
  "transaction_policy": {
    "isolated_workspace_required": true,
    "edit_lease_required": true,
    "journal_required": true,
    "rollback_path_required": true,
    "patch_provenance_required": true,
    "focused_regression_required": true,
    "destructive_edit_without_lease": "forbidden"
  },
  "independence_policy": {
    "implementation_and_verification_signers_must_differ": true,
    "exception_requires_explicit_accountability_independence_exception": true,
    "self_review_never_counts_as_independent_verification": true
  },
  "collision_policy": {
    "workgraph_conflict_keys_required": true,
    "same_path_concurrent_mutation": "forbidden",
    "same_owner_zone_concurrent_mutation": "requires non-overlap proof"
  }
}
