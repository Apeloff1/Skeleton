{
  "schema_version": "skeleton.interface_design_standard.v1",
  "standard_version": "0.1.0",
  "status": "active",
  "purpose": "Lint the canonical capability-interface registry for explicit ownership, boundary, error, compatibility and cancellation semantics.",
  "source": "machine/capability_interfaces.json",
  "source_git_blob_sha": "40c3a37f253be49f6b00ec12cd9bb4dc8f15454e",
  "rules": [
    {
      "id": "IFACE-OWNER",
      "severity": "blocking",
      "require": [
        "source_owner",
        "target_owner",
        "ownership_rule"
      ]
    },
    {
      "id": "IFACE-BOUNDARY",
      "severity": "blocking",
      "require": [
        "boundary",
        "binding"
      ]
    },
    {
      "id": "IFACE-FAILURE",
      "severity": "blocking",
      "require": [
        "target_failure_contract"
      ]
    },
    {
      "id": "IFACE-CONTRACT",
      "severity": "blocking",
      "require_nonempty": [
        "target_contract_surface"
      ]
    },
    {
      "id": "IFACE-ACCEPTANCE",
      "severity": "blocking",
      "require_nonempty": [
        "source_acceptance",
        "target_acceptance"
      ]
    },
    {
      "id": "IFACE-CANCEL",
      "severity": "blocking",
      "applies_when_contract_contains": [
        "cancel",
        "deadline"
      ],
      "require_failure_contract": true
    }
  ],
  "adapter_policy": {
    "provider_or_framework_specific_types": "must remain behind adapters and not become canonical interface identity",
    "cancellation": "cross-boundary cancellation/deadline semantics must be named when applicable",
    "errors": "every interface declares target_failure_contract"
  }
}
