  "purpose": "Deterministic, non-compensable completion rollups from signed atomic accountability through packages/waves while surfacing critical blockers.",
  "masterplan_binding": {
    "volume_ref": "VOL-119",
    "title": "Completion Model",
    "required_gap_texts": [
      "implement canonical rollup function",
      "bind UI progress to derived completion only"
    ]
