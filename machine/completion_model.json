    "machine/ai_master_build_sequence.json",
    "machine/ai_edge_case_priority_queue.json"
  ],
  "formula": {
    "atomic": "verified_atomic iff checkbox=true AND implementation_signoff.signed=true AND verification_signoff.signed=true",
