{
  "schema_version": "skeleton.project_self_improvement_epoch.v1",
  "version": "1.0.0",
  "purpose": "Deterministic per-project runtime contract for entering, executing, preempting and closing bounded mirror-room self-improvement epochs.",
  "authority": {
    "ladder": "machine/project_self_improvement_1000.json",
    "learning": "machine/learning_400_adversarial_400.json",
    "canonical_master_plan": "machine/ai_master_plan.json"
  },
  "project_key": [
    "project_id",
    "project_namespace",
    "baseline_revision",
    "policy_profile"
  ],
  "states": [
    "foreground_active",
    "idle_eligible",
    "baseline_freezing",
    "mirror_gap_mining",
    "candidate_synthesis",
    "adversarial_challenge",
    "sandbox_experiment",
    "causal_evaluation",
    "learning_consolidation",
    "promotion_pending",
    "closed",
    "preempted",
    "quarantined",
    "failed"
  ],
  "initial_state": "foreground_active",
  "terminal_states": [
    "closed",
    "preempted",
    "quarantined",
    "failed"
  ],
  "transitions": [
    {
      "from": "foreground_active",
      "to": "idle_eligible",
      "guard": "idle_predicate_true"
    },
    {
      "from": "idle_eligible",
      "to": "baseline_freezing",
      "guard": "resource_budget_reserved_and_project_lock_nonexclusive"
    },
    {
      "from": "baseline_freezing",
      "to": "mirror_gap_mining",
      "guard": "immutable_baseline_receipt_written"
    },
    {
      "from": "mirror_gap_mining",
      "to": "candidate_synthesis",
      "guard": "prioritized_gap_set_nonempty"
    },
    {
      "from": "candidate_synthesis",
      "to": "adversarial_challenge",
      "guard": "candidate_set_nonempty"
    },
    {
      "from": "adversarial_challenge",
      "to": "sandbox_experiment",
      "guard": "at_least_one_candidate_survives_initial_challenge"
    },
    {
      "from": "sandbox_experiment",
      "to": "causal_evaluation",
      "guard": "bounded_experiment_receipts_complete"
    },
    {
      "from": "causal_evaluation",
      "to": "learning_consolidation",
      "guard": "baseline_candidate_comparison_complete"
    },
    {
      "from": "learning_consolidation",
      "to": "promotion_pending",
      "guard": "project_learning_receipt_written"
    },
    {
      "from": "promotion_pending",
      "to": "closed",
      "guard": "candidate_promoted_rejected_or_quarantined_and_epoch_receipt_written"
    }
  ],
  "global_preemption_transitions": {
    "source_states": [
      "idle_eligible",
      "baseline_freezing",
      "mirror_gap_mining",
      "candidate_synthesis",
      "adversarial_challenge",
      "sandbox_experiment",
      "causal_evaluation",
      "learning_consolidation",
      "promotion_pending"
    ],
    "to": "preempted",
    "guards": [
      "foreground_instruction_arrived",
      "exclusive_project_mutation_requested",
      "mandatory_recovery_started",
      "safety_intervention_started",
      "protected_resource_reservation_violated"
    ],
    "action": "cancel_or_checkpoint_running_work; release protected resources; preserve receipts; never partially promote"
  },
  "idle_predicate": {
    "all": [
      "foreground_runnable_queue_empty_or_external_blocked_only",
      "no_unresolved_foreground_instruction_waiting_for_execution",
      "no_exclusive_project_mutation_lock_owned",
      "no_mandatory_recovery_or_safety_intervention",
      "resource_budget_available_without_violating_foreground_reservations"
    ],
    "false_on_unknown": true,
    "debounce": "allowed only to suppress trigger flapping; not to delay eligible work"
  },
  "locks": {
    "foreground_mutation_lock": {
      "priority": "absolute",
      "mirror_room_may_hold": false
    },
    "mirror_snapshot_lock": {
      "mode": "read_or_snapshot_only",
      "releasable_on_preemption": true
    },
    "candidate_namespace_lock": {
      "mode": "isolated_candidate_only",
      "production_write": false
    }
  },
  "epoch_budget_schema": {
    "required": [
      "epoch_id",
      "project_id",
      "wall_clock_limit",
      "experiment_limit",
      "model_compute_limit",
      "cpu_limit",
      "memory_limit",
      "storage_limit",
      "network_limit",
      "external_api_limit"
    ],
    "exhaustion_action": "close_or_checkpoint_epoch_and_emit_budget_exhaustion_receipt",
    "carryover": "none unless explicitly reauthorized by next epoch"
  },
  "baseline_receipt_schema": {
    "required": [
      "epoch_id",
      "project_id",
      "baseline_revision",
      "baseline_artifact_digest",
      "capability_vector_digest",
      "benchmark_snapshot_digest",
      "policy_profile_digest",
      "created_at"
    ]
  },
  "hypothesis_schema": {
    "required": [
      "hypothesis_id",
      "epoch_id",
      "psi_level_ids",
      "problem_statement",
      "mechanism",
      "predicted_gain",
      "predicted_cost",
      "predicted_risks",
      "falsification_conditions"
    ]
  },
  "candidate_receipt_schema": {
    "required": [
      "candidate_id",
      "epoch_id",
      "project_id",
      "baseline_revision",
      "candidate_type",
      "artifact_digest",
      "mechanism",
      "affected_contracts",
      "resource_cost",
      "rollback_digest"
    ]
  },
  "adversarial_receipt_schema": {
    "required": [
      "candidate_id",
      "challenge_suite_digest",
      "proposer_result_digest",
      "challenger_result_digest",
      "role_reversal_result_digest",
      "known_residual_risks",
      "survives"
    ]
  },
  "evaluation_receipt_schema": {
    "required": [
      "candidate_id",
      "baseline_metrics",
      "candidate_metrics",
      "held_out_metrics",
      "regressions",
      "causal_attribution",
      "uncertainty",
      "decision"
    ]
  },
  "learning_receipt_schema": {
    "required": [
      "epoch_id",
      "project_id",
      "accepted_lessons",
      "negative_results",
      "rejected_hypotheses",
      "new_skills",
      "benchmark_deltas",
      "open_questions",
      "transfer_candidates"
    ]
  },
  "promotion_receipt_schema": {
    "required": [
      "candidate_id",
      "exact_artifact_digest",
      "independent_verification_digest",
      "adversarial_qualification_digest",
      "non_compensable_gate_results",
      "rollback_digest",
      "promotion_decision",
      "promotion_authority",
      "created_at"
    ],
    "forbidden_authority": [
      "proposer_room",
      "challenger_room",
      "verifier_room"
    ]
  },
  "epoch_receipt_schema": {
    "required": [
      "epoch_id",
      "project_id",
      "baseline_revision",
      "terminal_state",
      "started_at",
      "ended_at",
      "budget_consumption",
      "hypotheses_considered",
      "candidates_considered",
      "candidate_decisions",
      "learning_receipt_digest",
      "preemption_reason",
      "next_idle_eligibility"
    ]
  },
  "invariants": [
    "no transition may grant production authority",
    "all experiments run against immutable or disposable project snapshots",
    "foreground work always preempts mirror work",
    "partial promotion is forbidden",
    "candidate identity is content-addressed or otherwise immutable",
    "negative results are durable project learning",
    "project-private evidence never transfers by default",
    "every epoch terminates before another epoch begins for the same project",
    "unknown idle state fails closed to foreground_active",
    "no project can satisfy another project's PSI-1000 maturity"
  ]
}
