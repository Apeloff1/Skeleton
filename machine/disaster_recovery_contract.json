  "recovery_units": [
    {
      "unit_id": "mongo-backend-core",
      "strategy": "mongo-logical-backup-restore",
      "restore_order": 10,
      "domain_ids": [
        "backend-core-app-state",
        "conversation-message-state",
        "conversation-thread-state"
      ],
      "backup_policy_store_ids": [],
      "depends_on_units": [],
      "rto_seconds": 900,
      "rpo_seconds": 300,
      "required_for_global_traffic": true,
      "verification_refs": [
        ".github/workflows/state-recovery-drill.yml",
        "scripts/state_recovery_drill.py",
        "skeleton/testing/test_state_recovery_drill.py"
      ],
