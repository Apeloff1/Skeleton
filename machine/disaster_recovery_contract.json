{
  "schema_version": "skeleton.ai.disaster_recovery_contract.v1",
  "status": "active",
  "gap_id": "G012",
  "topology_contract": "machine/state_topology.json",
  "backup_policy": "machine/state_backup_policy.json",
  "purpose": "Bind every current source-of-truth state domain and every required durable backup-policy store to one explicit recovery owner, order, RTO/RPO envelope, verification surface and traffic-admission gate.",
  "invariants": [
    "all source-of-truth domains have exactly one recovery unit",
    "all required backup-policy stores have exactly one recovery unit",
    "authoritative recovery gates global traffic until independently verified",
    "derived and projection rebuild occurs only after authoritative recovery",
    "recovery dependencies restore strictly before their dependents",
    "recovery evidence is executable repository evidence rather than prose-only intent",
    "unknown source-of-truth domains or backup stores fail closed"
  ],
  "domain_expectations": {
    "backend-core-app-state": {
      "authority": "authoritative",
      "owner_plane": "data-persistence",
      "physical_store": "mongo"
    },
    "canonical-ai-memory-records": {
      "authority": "authoritative",
      "owner_plane": "memory",
      "physical_store": "mongo"
    },
    "canonical-operation-state": {
      "authority": "authoritative",
      "owner_plane": "orchestration",
      "physical_store": "operation-state-sqlite"
    },
    "cognitive-execution-ledger": {
      "authority": "authoritative",
      "owner_plane": "orchestration",
      "physical_store": "engine-cognitive-sqlite"
    },
    "conversation-message-state": {
      "authority": "authoritative",
      "owner_plane": "application-api",
      "physical_store": "mongo"
    },
    "conversation-thread-state": {
      "authority": "authoritative",
      "owner_plane": "application-api",
      "physical_store": "mongo"
    },
    "engine-mongo-state": {
      "authority": "authoritative",
      "owner_plane": "data-persistence",
      "physical_store": "mongo"
    },
    "execution-usage-ledger": {
      "authority": "authoritative",
      "owner_plane": "cost-capacity",
      "physical_store": "engine-cognitive-sqlite"
    },
    "final-ai-result-ledger": {
      "authority": "authoritative",
      "owner_plane": "orchestration",
      "physical_store": "engine-cognitive-sqlite"
    },
    "governance-lifecycle-registry": {
      "authority": "authoritative",
      "owner_plane": "governance",
      "physical_store": "governance-lifecycle-sqlite"
    },
    "human-approval-ledger": {
      "authority": "authoritative",
      "owner_plane": "tool-runtime",
      "physical_store": "engine-cognitive-sqlite"
    },
    "local-reference-provenance": {
      "authority": "conditional-authoritative",
      "owner_plane": "observability",
      "physical_store": "snapshot-files"
    },
    "tool-idempotency-ledger": {
      "authority": "authoritative",
      "owner_plane": "tool-runtime",
      "physical_store": "engine-cognitive-sqlite"
    },
    "verification-receipt-ledger": {
      "authority": "authoritative",
      "owner_plane": "reasoning-verification",
      "physical_store": "engine-cognitive-sqlite"
    }
