  "schema_version": "skeleton.architecture.runtime_supervision.v2",
  "contract_version": "1.2.0",
  "status": "active",
  "purpose": "One executable backend/engine lifecycle and connector-cancellation contract covering readiness, draining, recovery, deadlines, cancellation propagation, retry interruption, late-result fencing and operation identity.",
  "masterplan_binding": {
    "volume_ref": "VOL-004",
    "title": "Kernel & Execution Foundation",
    "closed_implementation_gap_texts": [
      "unify service supervision semantics across backend and engine",
      "expand cancellation propagation coverage into all connectors"
    ],
    "remaining_verification_gap_text": "independent exact-head VOL-004 Runtime Supervision Closure qualification remains pending",
    "completion_requires_independent_exact_head": true
  },
