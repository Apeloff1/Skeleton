    "governed_lifecycle_mirror": "skeleton/ai/runtime/kernel/runtime_supervision.py",
    "construction_contract": "machine/ai_app_construction.json"
  },
  "invariants": [
    "backend depends on skeleton and mongo; skeleton depends on mongo",
    "backend and skeleton use the same RuntimeServiceLifecycle state machine",
    "shutdown cancellation is generation-bound and restart creates a fresh cancellation token",
    "backend cancellation delegates to the engine cancel endpoint rather than inventing local terminal truth",
    "engine cancellation is persisted through the execution repository and is idempotent around terminal state",
    "engine coordinator supports restart recovery and bounded shutdown",
    "operation and provider deadlines are explicit and cannot be created already expired",
    "operation identity is preserved across backend client and engine service boundaries",
    "every declared network-transport owner has explicit bounded cancellation semantics",
    "late connector results are fenced after cancellation and cannot become authoritative output",
    "only READY services admit new external work; startup recovery is the only explicit STARTING admission exception",
    "every admitted HTTP request and engine execution is generation-bound by a work lease",
    "DRAINING atomically revokes new-work authority while preserving accountability for already admitted work",
    "STOPPED cannot be asserted while in-flight work leases remain",
    "shutdown cancels/drains background execution before closing durable dependencies",
    "every network transport operation owned by a declared connector has explicit cancellation, timeout, deadline and late-result semantics",
    "engine-runtime operation coverage is derived from active provider capabilities and declared sync-adapter presence"
  ],
