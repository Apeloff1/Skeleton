      "loading",
      "assembling_context",
      "routing",
      "provider_pending",
      "provider_completed",
      "classifying_output",
      "waiting_for_tool_authority",
      "waiting_for_user",
      "tool_pending",
      "tool_completed",
      "checkpointing",
      "verifying",
      "repairing",
      "finalizing",
      "completed",
      "degraded",
      "failed",
      "cancelled"
    ],
    "FinishReason": [
