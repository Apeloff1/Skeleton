  "records": {
    "OperationEnvelope": {
      "schema_version": 1,
      "owner_plane": "orchestration",
      "fields": {
        "operation_id": {
          "type": "OpaqueId"
        },
        "tenant_id": {
          "type": "TenantId"
        },
        "actor_id": {
          "type": "ActorId"
        },
        "capability": {
          "type": "CapabilityId"
        },
        "created_at": {
          "type": "RFC3339"
        },
        "deadline": {
          "type": "RFC3339",
          "nullable": true
        },
        "idempotency_key": {
          "type": "string",
          "min_length": 1,
          "max_length": 256
        },
        "trace_id": {
          "type": "OpaqueId"
        },
        "state": {
          "type": "OperationState"
        },
        "version": {
          "type": "NonNegativeInt"
        }
      },
      "invariants": [
        "operation_id != trace_id",
        "terminal states completed/failed/cancelled never transition",
        "deadline if present is >= created_at",
        "version is monotonic"
      ]
    },
