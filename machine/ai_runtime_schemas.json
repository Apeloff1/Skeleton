  "cross_record_invariants": [
    "tenant_id must not change across conversation message -> operation -> execution -> tool/memory/result lineage",
    "actor/service identities may differ by boundary but delegated authority preserves the initiating actor and tenant",
    "ContextEnvelope.context_digest binds the exact model-visible source snapshot for AgentTurn",
    "ProviderToolCall.tool_id must exist in tools offered for the bound ProviderRequest",
    "ToolExecutionReceipt.arguments_digest must equal ProviderToolCall/ToolCallProposal digest after canonical normalization",
    "VerificationReceipt selected by AIExecutionResult must verify the same candidate/result lineage",
    "assistant ConversationMessage.execution_result_id points to the canonical AIExecutionResult used for its content",
    "completed StreamEvent references a terminal operation whose AIExecutionResult already exists"
  ]
}
