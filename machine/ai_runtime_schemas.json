{
  "schema_version": 1,
  "catalog_version": "1.0.0",
  "status": "active",
  "architecture_tag": "arch-map/v3.7",
  "purpose": "Typed provider-neutral schema catalog for the fully functional AI runtime. These schemas refine, but do not replace, canonical ownership in machine/ai_app_construction.json.",
  "conventions": {
    "unknown_fields": "reject by default for command/authority records; additive-compatible readers may ignore explicitly versioned optional response fields",
    "timestamps": "RFC3339 UTC strings with explicit timezone; persisted writers normalize to UTC",
    "ids": "opaque stable strings; callers must not infer storage/provider semantics from ID shape",
    "digests": "lowercase SHA-256 hex over canonical bytes/JSON unless a record explicitly declares another algorithm",
    "money": "non-negative decimal string plus declared currency when monetary precision is required",
    "nullability": "fields are non-null unless nullable=true",
    "arrays": "ordered unless semantics explicitly declare set behavior",
    "maps": "JSON object with string keys and bounded depth/size",
    "canonical_json": "UTF-8, deterministic key ordering, no NaN/Infinity, normalized scalar representation",
    "versioning": "persisted/wire records carry schema_version where their independent evolution requires it"
  },
  "scalar_types": {
    "OpaqueId": {
      "type": "string",
      "min_length": 1,
      "max_length": 192
    },
    "TenantId": {
      "type": "string",
      "min_length": 1,
      "max_length": 192
    },
    "ActorId": {
      "type": "string",
      "min_length": 1,
      "max_length": 192
    },
    "CapabilityId": {
      "type": "string",
      "min_length": 1,
      "max_length": 192
    },
    "RFC3339": {
      "type": "string",
      "format": "date-time"
    },
    "Digest256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "NonNegativeInt": {
      "type": "integer",
      "minimum": 0
    },
    "PositiveInt": {
      "type": "integer",
      "minimum": 1
    },
    "NonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "Probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "JsonObject": {
      "type": "object",
      "additional_properties": true
    },
    "Ref": {
      "type": "string",
      "min_length": 1,
      "max_length": 2048
    }
  },
  "enums": {
    "DataClass": [
      "public",
      "internal",
      "confidential",
      "restricted"
    ],
    "OperationState": [
