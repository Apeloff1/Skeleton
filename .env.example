# ============================================================================
# Tutolage - Root Environment Template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================================

# --- OpenAI / LLM ---
OPENAI_API_KEY=sk-your-key-here

# --- MongoDB ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=tutolage

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Stripe (optional) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Reverse proxy trust boundary ---
# Only these immediate peers may supply X-Forwarded-For. Configure the exact
# ingress/load-balancer CIDRs used by your deployment; do not use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# --- Safe default for code execution ---
# Set to true only for trusted local/test deployments. Default is false.
ALLOW_UNSAFE_CODE_EXECUTION=false
# Production host execution has a second independent gate and should remain
# false unless the host itself is deliberately isolated as an execution worker.
ALLOW_PRODUCTION_HOST_CODE_EXECUTION=false

# --- Request/rate-limit hardening ---
CODEDOCK_MAX_BODY_MB=25
CODEDOCK_RATE_LIMIT_RPS=2
CODEDOCK_RATE_LIMIT_BURST=120
CODEDOCK_RATE_LIMIT_MAX_BUCKETS=20000
CODEDOCK_RATE_LIMIT_BUCKET_TTL_SECONDS=900
RATE_LIMIT_MAX_BUCKETS=10000
RATE_LIMIT_BUCKET_TTL_SECONDS=900

# --- Forge HMAC seal (mutate routes) ---
GF_SEAL_SECRET=
# Optional rotatable HMAC keyring (kid=secret,kid2=secret2). Verify tries all; mint uses GF_SEAL_SECRET.
GF_SEAL_KEYRING=

# Process signing identity (keyholder). Hex, 32 bytes. Empty → ephemeral.
GF_KEYHOLDER_SEED=
