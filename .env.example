# ============================================================================
# Tutolage - Root Environment Template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================================

# --- Runtime AI (credentials belong only to the engine) ---
# A fresh install can start without a model. AI remains unavailable until an
# operator configures a trained local model or a real hosted-provider key.
OPENAI_API_KEY=
AI_PROVIDER=local
AI_MODEL=
# Exactly one path when local AI is configured. These are paths INSIDE the
# engine container, not paths on the operator's host. See docs/APP_ASSEMBLY.md.
AI_LOCAL_MODEL_PATH=
AI_LOCAL_DEPLOYMENT_PATH=
AI_TIMEOUT_SECONDS=120
SKELETON_ENGINE_EXECUTION_TIMEOUT_S=600
# Operator-provisioned files only. The mount does not activate or download AI.
SKELETON_LOCAL_MODEL_DIR=./data/local-ai

# Initialize only empty canonical Dragon practice/review schemas on backend_data.
# This never approves crawled knowledge, runs models or starts a training scheduler.
SKL_DRAGON_RUNTIME_BOOTSTRAP=1

# --- MongoDB ---
# Compose requires authenticated URIs for both application stacks. Passwords in
# MongoDB URIs must be URL-encoded. Keep populated values out of source control.
MONGO_URL=
SKL_MONGO_URI=
DB_NAME=tutolage
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=
MONGO_PORT=27017

# --- Auth ---
# Generate a high-entropy random secret; never reuse or commit it.
JWT_SECRET=
# Persistent signing identity for the existing GameForge account/login owner.
GAMEFORGE_JWT_SECRET=
GAMEFORGE_AUTH_ENFORCE=true
# Optional operator-selected bootstrap admin. Configure BOTH explicitly; no
# public/default admin password is installed. Use at least 16 password characters.
GAMEFORGE_SEED_ADMIN_EMAIL=
GAMEFORGE_SEED_ADMIN_PASSWORD=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# First launch retains schema/index/auth bootstrap without generated libraries,
# launch-prefill or automatic toolchain installs. Bulk sample data is opt-in.
SKIP_HEAVY_SEED=true
# Existing optional idle research is separate from authenticated manual crawl.
# Its durable state is placed under backend_data by Compose.
CURIOSITY_IDLE_ENABLED=false

# --- Stripe (optional) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Browser-facing application endpoints ---
# Leave these blank for Compose to derive local backend and engine ports in
# development. A production Expo static export instead uses nginx same-origin
# routing unless explicitly configured at build time. Set explicit addresses
# only for operator-managed external API or mobile deployments.
EXPO_PUBLIC_BACKEND_URL=
EXPO_PUBLIC_SKELETON_URL=

# --- ChromaDB host binding ---
CHROMA_PORT=8000

# --- Safe default for code execution ---
# Set to true only for trusted local/test deployments. Default is false.
ALLOW_UNSAFE_CODE_EXECUTION=false

# --- Backend -> Skeleton engine service authentication ---
# Generate at least 32 random characters. Shared only by backend and Skeleton.
SKL_ENGINE_SERVICE_TOKEN=
SKL_ENGINE_SERVICE_PRINCIPAL=codedock-backend

# --- Skeleton encrypted secret store ---
# Required before persistent secrets can be read or written.
# Generate a long, unique random value per deployment; never commit the real value.
SKELETON_MASTER_SECRET=

# --- Forge HMAC seal (mutate routes) ---
GF_SEAL_SECRET=
# Optional rotatable HMAC keyring (kid=secret,kid2=secret2). Verify tries all; mint uses GF_SEAL_SECRET.
GF_SEAL_KEYRING=

# Process signing identity (keyholder). Hex, 32 bytes. Empty → ephemeral.
GF_KEYHOLDER_SEED=

# Canonical operation stream transport
# Bounded replay pages prevent slow clients from forcing large in-memory SSE batches.
CODEDOCK_OPERATION_STREAM_SSE_BATCH_LIMIT=64
# Fenced outbox projection lease; expiry permits another backend worker to take over.
CODEDOCK_OPERATION_STREAM_PROJECTION_LEASE_SECONDS=10
CODEDOCK_OPERATION_STREAM_POLL_SECONDS=0.25
CODEDOCK_OPERATION_STREAM_HEARTBEAT_SECONDS=15
CODEDOCK_OPERATION_STREAM_IDLE_TIMEOUT_SECONDS=300
