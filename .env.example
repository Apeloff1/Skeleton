# ============================================================================
# Tutolage - Root Environment Template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================================

# --- OpenAI / LLM ---
OPENAI_API_KEY=sk-your-key-here

# --- MongoDB ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=tutolage

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Stripe (optional) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Forge HMAC seal (mutate routes) ---
GF_SEAL_SECRET=
# Optional rotatable HMAC keyring (kid=secret,kid2=secret2). Verify tries all; mint uses GF_SEAL_SECRET.
GF_SEAL_KEYRING=
