# ============================================================================
# Tutolage - Root Environment Template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================================

# --- OpenAI / LLM ---
OPENAI_API_KEY=sk-your-key-here

# --- MongoDB ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=tutolage
MONGO_INITDB_ROOT_USERNAME=admin
# Required by docker-compose.yml. Generate a unique strong password.
MONGO_INITDB_ROOT_PASSWORD=
MONGO_PORT=27017

# --- Auth ---
# Required by docker-compose.yml. Generate a high-entropy random secret; do not
# reuse credentials or commit the populated value.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Stripe (optional) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- ChromaDB host binding ---
CHROMA_PORT=8000

# --- Safe default for code execution ---
# Set to true only for trusted local/test deployments. Default is false.
ALLOW_UNSAFE_CODE_EXECUTION=false

# --- Skeleton encrypted secret store ---
# Required before persistent secrets can be read or written.
# Generate a long, unique random value per deployment; never commit the real value.
SKELETON_MASTER_SECRET=

# --- Forge HMAC seal (mutate routes) ---
GF_SEAL_SECRET=
# Optional rotatable HMAC keyring (kid=secret,kid2=secret2). Verify tries all; mint uses GF_SEAL_SECRET.
GF_SEAL_KEYRING=

# Process signing identity (keyholder). Hex, 32 bytes. Empty → ephemeral.
GF_KEYHOLDER_SEED=
