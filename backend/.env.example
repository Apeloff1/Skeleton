# ============================================================================
# Tutolage Backend - Environment Template
# Copy to backend/.env and fill in real values. NEVER commit .env.
# ============================================================================

# --- Server ---
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development

# --- MongoDB ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=tutolage

# --- OpenAI / LLM ---
OPENAI_API_KEY=sk-your-key-here
EMERGENT_LLM_KEY=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- ChromaDB (RAG) ---
CHROMA_PERSIST_DIR=./chroma_data

# --- Stripe (optional) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Security / request boundary ---
# Comma-separated trusted proxy CIDRs. Required in production when forwarding headers are trusted.
TRUSTED_PROXY_CIDRS=
# Per-IP API token bucket. Production values are validated at startup by core.security_config.
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_BURST=60
RATE_LIMIT_EXEMPT=127.0.0.1,::1,localhost
# Access logging: 1 enables, 0 disables. Production deployments should leave this enabled.
ACCESS_LOG=1
