# ============================================================================
# Tutolage Backend - Environment Template
# Copy to backend/.env and fill in real values. NEVER commit .env.
# ============================================================================

# --- Server ---
PORT=8001
HOST=0.0.0.0
# Security-sensitive settings are strict when ENVIRONMENT=production or prod:
# explicitly malformed booleans, numbers, or trusted-proxy CIDRs fail closed.
ENVIRONMENT=development

# --- MongoDB ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=tutolage

# --- OpenAI / LLM ---
OPENAI_API_KEY=sk-your-key-here
EMERGENT_LLM_KEY=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- ChromaDB (RAG) ---
CHROMA_PERSIST_DIR=./chroma_data

# --- Stripe (optional) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Network trust boundary ---
# X-Forwarded-For is ignored unless the immediate peer belongs to one of these
# CIDRs. Keep this narrow: configure only your actual ingress/LB proxy ranges.
# An invalid explicitly configured CIDR list is fatal in production.
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# --- Request/rate-limit hardening ---
CODEDOCK_MAX_BODY_MB=25
CODEDOCK_RATE_LIMIT_RPS=2
CODEDOCK_RATE_LIMIT_BURST=120
CODEDOCK_RATE_LIMIT_MAX_BUCKETS=20000
CODEDOCK_RATE_LIMIT_BUCKET_TTL_SECONDS=900
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_BURST=60
RATE_LIMIT_MAX_BUCKETS=10000
RATE_LIMIT_BUCKET_TTL_SECONDS=900
# Accepted boolean values: 1/0, true/false, yes/no, on/off.
ACCESS_LOG=1
