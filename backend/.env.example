# ============================================================================
# Tutolage Backend - Environment Template
# Copy to backend/.env and fill in real values. NEVER commit .env.
# ============================================================================

# --- Server ---
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development

# --- MongoDB ---
# Supply an authenticated MongoDB URI. URL-encode credentials embedded in it.
MONGO_URL=
DB_NAME=tutolage

# --- AI / LLM provider runtime ---
# Canonical provider selected by backend/core/ai_provider.py.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Override when pinning a deployment to a supported model.
AI_MODEL=gpt-5.5
# Optional OpenAI-compatible endpoint override. Leave empty for the default API.
OPENAI_BASE_URL=
# Provider request resilience. Invalid values fall back to safe defaults.
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
# Legacy compatibility only. Migrated text generation no longer forwards this
# universal key into provider clients; keep it unset unless isolated legacy
# image/provider code still requires it during the remaining migration.
EMERGENT_LLM_KEY=

# --- Auth ---
# Generate a high-entropy random secret; never reuse or commit it.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Privileged /api/advanced boundary. Required to enable advanced endpoints.
# Generate a unique high-entropy value of at least 32 bytes and keep it
# server-side; never embed this token in browser or mobile client bundles.
CODEDOCK_ADVANCED_ADMIN_TOKEN=

# --- ChromaDB (RAG) ---
CHROMA_PERSIST_DIR=./chroma_data

# --- Stripe (optional) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Security / request boundary ---
# Comma-separated trusted proxy CIDRs. Required in production when forwarding headers are trusted.
TRUSTED_PROXY_CIDRS=
# Per-IP API token bucket. Production values are validated at startup by core.security_config.
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_BURST=60
RATE_LIMIT_EXEMPT=127.0.0.1,::1,localhost
# Access logging: 1 enables, 0 disables. Production deployments should leave this enabled.
ACCESS_LOG=1