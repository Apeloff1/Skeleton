#!/usr/bin/env python3
"""
Galaxy Studio Phase-3 decomposition regression — backend test.
"""
import os
import sys
import subprocess
import requests

BASE = os.environ.get("EXPO_PUBLIC_BACKEND_URL", "https://gemini-game-craft.preview.emergentagent.com").rstrip("/")
API = f"{BASE}/api"
TIMEOUT = 30

results = []


def check(name, passed, detail=""):
    results.append((name, bool(passed), detail))
    print(f"{'✅' if passed else '❌'} {name}  {detail}")


def get(path, **kw):
    return requests.get(f"{API}{path}", timeout=TIMEOUT, **kw)


def post(path, **kw):
    return requests.post(f"{API}{path}", timeout=TIMEOUT, **kw)


# Section 2: code-library sub-router endpoints
print("\n=== Section 2: Code-library sub-router endpoints ===")
r = get("/galaxy-studio/code-library/stats")
ok = r.status_code == 200
body = r.json() if ok else {}
required = {"status", "total_snippets", "virtual_line_count", "per_category",
            "per_genre", "per_era", "per_language", "collection"}
keys_present = required.issubset(body.keys())
total = body.get("total_snippets", 0)
coll = body.get("collection")
check("GET /code-library/stats → 200", ok, f"status={r.status_code}")
check("Stats has required keys", keys_present,
      f"missing={required - set(body.keys())}")
check("Stats total_snippets >= 12000", total >= 12000,
      f"total_snippets={total}")
check("Stats collection == game_code_library",
      coll == "game_code_library", f"collection={coll}")

r = post("/galaxy-studio/code-library/search", json={"limit": 5})
ok = r.status_code == 200
body = r.json() if ok else {}
needed = {"query", "total", "returned", "skip", "limit", "snippets"}
keys_ok = needed.issubset(body.keys())
ret = body.get("returned", 999)
check("POST /code-library/search {limit:5} → 200", ok,
      f"status={r.status_code}")
check("Search response has required keys", keys_ok,
      f"missing={needed - set(body.keys())}")
check("Search returned <= 5", ret <= 5, f"returned={ret}")

r = post("/galaxy-studio/code-library/search",
         json={"category": "rendering", "limit": 3})
ok = r.status_code == 200
body = r.json() if ok else {}
ret = body.get("returned", 999)
q = body.get("query", {})
check("POST /code-library/search {category=rendering,limit=3} → 200", ok,
      f"status={r.status_code}")
check("Search filter category=rendering applied",
      q.get("category") == "rendering", f"query={q}")
check("Search returned <= 3", ret <= 3, f"returned={ret}")

# Section 3: Galaxy Studio regression
print("\n=== Section 3: Galaxy Studio regression ===")
for path in [
    "/galaxy-studio/manifest",
    "/galaxy-studio/eas/whoami",
    "/galaxy-studio/swarm/cold/stats",
    "/galaxy-studio/agent-db-manifest",
]:
    r = get(path)
    check(f"GET {path} → 200", r.status_code == 200,
          f"status={r.status_code}")

# Section 4: Health endpoints
print("\n=== Section 4: Health endpoints ===")
r = get("/health/overview")
ok = r.status_code == 200
body = r.json() if ok else {}
check("GET /health/overview → 200", ok, f"status={r.status_code}")
check("health/overview all_green=true",
      body.get("all_green") is True, f"all_green={body.get('all_green')}")
elapsed = body.get("elapsed_ms", 99999)
check("health/overview elapsed_ms <= 250",
      elapsed <= 250, f"elapsed_ms={elapsed}")

r = get("/health/registry")
ok = r.status_code == 200
body = r.json() if ok else {}
check("GET /health/registry → 200", ok, f"status={r.status_code}")
check("health/registry ok == 111 skipped == 0",
      body.get("ok") == 111 and body.get("skipped") == 0,
      f"ok={body.get('ok')} skipped={body.get('skipped')}")

r = get("/health/redundancies")
ok = r.status_code == 200
body = r.json() if ok else {}
check("GET /health/redundancies → 200", ok, f"status={r.status_code}")
check("redundancies total == 42", body.get("total") == 42,
      f"total={body.get('total')}")

r = get("/world-engine/genres")
ok = r.status_code == 200
body = r.json() if ok else {}
check("GET /world-engine/genres → 200", ok, f"status={r.status_code}")
check("world-engine/genres count == 5", body.get("count") == 5,
      f"count={body.get('count')}")

# Section 1: SSOT invariant
print("\n=== Section 1: SSOT invariant (start-build → build-status) ===")
build_id = None
r = post("/galaxy-studio/create",
         json={"title": "ssot_test", "genre": "rpg", "art_style": "stylized"})
if r.status_code == 200:
    b = r.json()
    build_id = b.get("build_id") or b.get("id")
    check("POST /galaxy-studio/create → 200", True, f"build_id={build_id}")
else:
    check("POST /galaxy-studio/create → 200", False,
          f"status={r.status_code} body={r.text[:200]}")

if build_id:
    # try a couple of plausible status endpoints
    found = False
    for p in (f"/galaxy-studio/build-status/{build_id}",
              f"/galaxy-studio/status/{build_id}",
              f"/galaxy-studio/build/{build_id}/status",
              f"/galaxy-studio/builds/{build_id}"):
        r2 = get(p)
        if r2.status_code == 200:
            body = r2.json()
            same_id = (body.get("build_id") == build_id
                       or body.get("id") == build_id)
            check(f"GET {p} → 200 (proves SSOT _builds read)", True,
                  f"same_id={same_id}")
            check("Status returns same build_id", same_id,
                  f"got_id={body.get('build_id') or body.get('id')}")
            found = True
            break
    if not found:
        check("GET build-status endpoint → 200", False,
              "no plausible status path returned 200")

# Section 5: pytest
print("\n=== Section 5: pytest test_routes_registry ===")
try:
    proc = subprocess.run(
        ["python", "-m", "pytest",
         "/app/backend/tests/test_routes_registry.py", "-q"],
        capture_output=True, text=True, timeout=120, cwd="/app/backend"
    )
    combined = proc.stdout + proc.stderr
    last = (combined.strip().splitlines() or [""])[-1]
    passed_113 = "113 passed" in combined
    check("pytest test_routes_registry → 113 passed",
          passed_113, f"last_line={last!r}")
except Exception as e:
    check("pytest test_routes_registry", False, f"exception={e}")

passed_total = sum(1 for _, p, _ in results if p)
total_n = len(results)
print(f"\n========== SUMMARY: {passed_total}/{total_n} passed ==========")
for name, p, detail in results:
    if not p:
        print(f"  FAIL: {name}  {detail}")

sys.exit(0 if passed_total == total_n else 1)
