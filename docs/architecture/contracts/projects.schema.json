{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.projects.v1",
  "title": "Skeleton Projects resource",
  "description": "Contract-only Projects resource. Routes are not mounted. Builds are engine executions identified by execution_id.",
  "x-schema-version": "1.0.0",
  "x-typed-module": "skeleton/contracts/projects.py",
  "x-routes": [
    {"method": "POST", "path": "/api/v1/projects", "body": "ProjectCreateRequest", "response": "Project"},
    {"method": "GET", "path": "/api/v1/projects", "response": "ProjectList"},
    {"method": "GET", "path": "/api/v1/projects/{project_id}", "response": "Project"},
    {"method": "POST", "path": "/api/v1/projects/{project_id}/builds", "body": "ProjectBuildLinkRequest", "response": "ProjectBuildLink"}
  ],
  "x-error-envelope": {
    "type": "object",
    "required": ["error"],
    "properties": {
      "error": {
        "type": "object",
        "required": ["type", "code", "message", "context"],
        "properties": {
          "type": {"const": "ProjectContractError"},
          "code": {"enum": ["PROJECT.INVALID", "PROJECT.NOT_FOUND", "PROJECT.BUILD_CONFLICT"]},
          "message": {"type": "string"},
          "context": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "ProjectBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "summary": {"type": "string", "maxLength": 8000},
        "genre": {"type": "string", "maxLength": 80},
        "constraints": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "ProjectCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "actor_id", "tenant_id", "brief"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "actor_id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "brief": {"$ref": "#/$defs/ProjectBrief"}
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "project_id", "actor_id", "tenant_id", "brief", "status", "build_ids", "created_at", "updated_at"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "project_id": {"type": "string"},
        "actor_id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "brief": {"$ref": "#/$defs/ProjectBrief"},
        "status": {"enum": ["draft", "active", "archived"]},
        "build_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "description": "Engine execution_id from BuildsClient"}
        },
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"}
      }
    },
    "ProjectList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "items", "next_cursor"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/Project"}},
        "next_cursor": {"type": ["string", "null"]}
      }
    },
    "ProjectBuildLinkRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "actor_id", "tenant_id", "execution_id"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "actor_id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "execution_id": {"type": "string", "description": "Existing engine execution. This request does not submit a build."}
      }
    },
    "ProjectBuildLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "project_id", "execution_id", "linked_at", "replayed"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "project_id": {"type": "string"},
        "execution_id": {"type": "string"},
        "linked_at": {"type": "string"},
        "replayed": {"type": "boolean"}
      }
    }
  }
}
