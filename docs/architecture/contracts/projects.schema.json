{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.projects.v1",
  "title": "Skeleton Projects resource",
  "description": "Projects HTTP contract for the #4097 router moved to /api/v1/projects inside create_app behind install_gate. Resources match ProjectOut and BuildOut. brief is a string or a structured object. POST /builds starts a server-side build unless execution_id links an existing one. Caller identity comes from the bearer session.",
  "x-schema-version": "1.1.0",
  "x-typed-module": "skeleton/contracts/projects.py",
  "x-implementation": {
    "pull_request": 4097,
    "branch": "is/app-foundation-persistence",
    "commit": "7065e555f9fff380a85ae479a79d3c34966ca097",
    "observed_prefix": "/api/app/projects",
    "mount": "create_app",
    "gate": "install_gate"
  },
  "x-auth": {
    "scheme": "bearer-session",
    "header": "Authorization",
    "identity": "Session principal. actor_id is the session user and is stored as owner_id. tenant_id is session scope when present. Neither is a request field."
  },
  "x-routes": [
    {"method": "POST", "path": "/api/v1/projects", "status": 201, "body": "ProjectCreateRequest", "response": "Project"},
    {"method": "GET", "path": "/api/v1/projects", "status": 200, "response": "ProjectList"},
    {"method": "GET", "path": "/api/v1/projects/{project_id}", "status": 200, "response": "Project"},
    {"method": "POST", "path": "/api/v1/projects/{project_id}/builds", "status": 202, "body": "BuildCreateRequest", "response": "Build"},
    {"method": "GET", "path": "/api/v1/projects/{project_id}/builds", "status": 200, "response": "BuildList"},
    {"method": "GET", "path": "/api/v1/projects/{project_id}/builds/{build_id}", "status": 200, "response": "Build"}
  ],
  "x-error-envelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["error"],
    "properties": {
      "error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "code", "message", "context"],
        "properties": {
          "type": {"const": "ProjectContractError"},
          "code": {
            "enum": [
              "PROJECT.INVALID",
              "PROJECT.UNAUTHENTICATED",
              "PROJECT.NOT_FOUND",
              "PROJECT.BUILD_NOT_FOUND",
              "PROJECT.CONFLICT",
              "PROJECT.BUILD_CONFLICT"
            ]
          },
          "message": {"type": "string", "minLength": 1},
          "context": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "ProjectBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "summary": {"type": "string", "maxLength": 8000},
        "genre": {"type": "string", "maxLength": 80},
        "constraints": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "Brief": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 20000},
        {"$ref": "#/$defs/ProjectBrief"}
      ]
    },
    "ProjectCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief"],
      "properties": {
        "brief": {"$ref": "#/$defs/Brief"},
        "name": {"type": "string", "maxLength": 200},
        "settings": {"type": "object"}
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "owner_id", "name", "brief", "settings", "created_at", "updated_at"],
      "properties": {
        "project_id": {"type": "string"},
        "owner_id": {"type": "string", "description": "Session user id. Clients do not send this."},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "brief": {"$ref": "#/$defs/Brief"},
        "settings": {"type": "object"},
        "created_at": {"type": "number", "minimum": 0, "description": "Epoch seconds, matching ProjectOut."},
        "updated_at": {"type": "number", "minimum": 0}
      }
    },
    "ProjectList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects"],
      "properties": {
        "projects": {"type": "array", "items": {"$ref": "#/$defs/Project"}}
      }
    },
    "BuildCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {"type": "string", "maxLength": 64},
        "options": {"type": "object"},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
        "execution_id": {
          "type": "string",
          "description": "Optional. When present, link this execution and do not start a new build job."
        }
      }
    },
    "Build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_id", "project_id", "status", "target", "job_id", "result", "error", "created_at", "updated_at", "execution_id"],
      "properties": {
        "build_id": {"type": "string"},
        "project_id": {"type": "string"},
        "status": {"enum": ["pending", "queued", "running", "succeeded", "failed", "cancelled"]},
        "target": {"type": "string", "maxLength": 64},
        "job_id": {"type": ["string", "null"]},
        "result": {"type": "object"},
        "error": {"type": "string", "maxLength": 4000},
        "created_at": {"type": "number", "minimum": 0},
        "updated_at": {"type": "number", "minimum": 0},
        "execution_id": {"type": "string", "description": "Engine execution this build started or linked."}
      }
    },
    "BuildList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builds"],
      "properties": {
        "builds": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/Build"}}
      }
    }
  }
}
