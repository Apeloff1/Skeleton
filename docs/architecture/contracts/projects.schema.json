{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.projects.v1",
  "title": "Skeleton Projects resource",
  "description": "Projects HTTP contract implemented by PR #4097 at /api/v1/projects inside create_app behind install_gate. actor_id and tenant_id come from the session. A string brief is stored as a brief object. POST /builds starts a game.build job unless execution_id links an existing execution.",
  "x-schema-version": "1.0.0",
  "x-typed-module": "skeleton/contracts/projects.py",
  "x-implementation": {
    "pull_request": 4097,
    "commit": "959eec1345f767208fb4c5dda6e7bd25b07058c3",
    "module": "skeleton/api/projects_routes.py",
    "mount": "create_app",
    "gate": "install_gate",
    "job_queue": "docs/contracts/job_queue.md"
  },
  "x-auth": {
    "seal": "x-gf-seal",
    "session": "Authorization: Bearer <session>",
    "actor_id": "session user id",
    "tenant_id": "APP_TENANT_ID, default default"
  },
  "x-routes": [
    {"method": "POST", "path": "/api/v1/projects", "status": 201, "replay_status": 200, "body": "ProjectCreateRequest", "response": "Project"},
    {"method": "GET", "path": "/api/v1/projects", "status": 200, "response": "ProjectList"},
    {"method": "GET", "path": "/api/v1/projects/{project_id}", "status": 200, "response": "Project"},
    {"method": "POST", "path": "/api/v1/projects/{project_id}/builds", "status": 202, "body": "BuildStartRequest", "response": "Build"},
    {"method": "GET", "path": "/api/v1/projects/{project_id}/builds", "status": 200, "response": "BuildList"},
    {"method": "GET", "path": "/api/v1/projects/{project_id}/builds/{build_id}", "status": 200, "response": "Build"}
  ],
  "x-error-envelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["error"],
    "properties": {
      "error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "code", "message", "context"],
        "properties": {
          "type": {"const": "ProjectContractError"},
          "code": {
            "enum": [
              "PROJECT.INVALID",
              "PROJECT.UNAUTHENTICATED",
              "PROJECT.NOT_FOUND",
              "PROJECT.BUILD_CONFLICT",
              "PROJECT.NAME_CONFLICT",
              "PROJECT.IDEMPOTENCY_MISMATCH",
              "PROJECT.UNAVAILABLE"
            ]
          },
          "message": {"type": "string", "minLength": 1},
          "context": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "ProjectBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "summary": {"type": "string", "maxLength": 8000},
        "genre": {"type": "string", "maxLength": 80},
        "constraints": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "BriefInput": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"$ref": "#/$defs/ProjectBrief"}
      ]
    },
    "ProjectCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief"],
      "properties": {
        "brief": {"$ref": "#/$defs/BriefInput"},
        "schema_version": {"const": "1.0.0"},
        "actor_id": {"type": "string", "description": "Optional. Must equal the session user or the call is PROJECT.INVALID."},
        "tenant_id": {"type": "string", "description": "Optional. Must equal APP_TENANT_ID or the call is PROJECT.INVALID."}
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "project_id", "actor_id", "tenant_id", "brief", "status", "build_ids", "created_at", "updated_at"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "project_id": {"type": "string"},
        "actor_id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "brief": {"$ref": "#/$defs/ProjectBrief"},
        "status": {"enum": ["draft", "active", "archived"]},
        "build_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "created_at": {"type": "string", "description": "RFC3339 UTC ending in Z."},
        "updated_at": {"type": "string"}
      }
    },
    "ProjectList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "items", "next_cursor"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/Project"}},
        "next_cursor": {"type": ["string", "null"], "description": "r:<rowid>, or null on the last page."}
      }
    },
    "BuildStartRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {"type": "string", "maxLength": 64},
        "options": {"type": "object"},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
        "schema_version": {"const": "1.0.0"},
        "actor_id": {"type": "string"},
        "tenant_id": {"type": "string"}
      }
    },
    "ProjectBuildLinkRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id"],
      "properties": {
        "execution_id": {"type": "string"},
        "schema_version": {"const": "1.0.0"},
        "actor_id": {"type": "string"},
        "tenant_id": {"type": "string"}
      }
    },
    "ProjectBuildLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "project_id", "execution_id", "linked_at", "replayed"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "project_id": {"type": "string"},
        "execution_id": {"type": "string"},
        "linked_at": {"type": "string"},
        "replayed": {"type": "boolean"}
      }
    },
    "Build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "schema_id", "build_id", "execution_id", "project_id", "status", "target", "job_id", "result", "error", "created_at", "updated_at", "replayed"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "schema_id": {"const": "skeleton.projects.v1"},
        "build_id": {"type": "string"},
        "execution_id": {"type": "string", "description": "Equal to build_id for a started build."},
        "project_id": {"type": "string"},
        "status": {"enum": ["pending", "queued", "running", "succeeded", "failed", "cancelled"]},
        "target": {"type": "string", "maxLength": 64},
        "job_id": {"type": ["string", "null"]},
        "result": {"type": "object"},
        "error": {"type": "string"},
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"},
        "replayed": {"type": "boolean"}
      }
    },
    "BuildList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "items", "next_cursor"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/Build"}},
        "next_cursor": {"type": ["string", "null"]}
      }
    }
  }
}
