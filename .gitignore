# ============================================================================
# Git Ignore for Tutolage
# ============================================================================

# ==========================================================================
# Python
# ==========================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# ==========================================================================
# Node.js
# ==========================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================================================
# Expo / React Native
# ==========================================================================
.expo/
.expo-shared/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ==========================================================================
# IDE
# ==========================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ==========================================================================
# Environment & Secrets (NEVER commit real env files — keep only .env.example)
# ==========================================================================
.env
.env.*
*.env
!.env.example
secrets/
*.pem
credentials.json
service-account.json
.credentials

# ==========================================================================
# Testing & Coverage
# ==========================================================================
.coverage
htmlcov/
coverage_html/
coverage.xml
*.cover
.pytest_cache/
.tox/
.nox/
test_reports/
test_result.md

# ==========================================================================
# Build & Artifacts
# ==========================================================================
*.log
*.tmp
*.temp
.cache/
.ruff_cache/
.mypy_cache/

# Stray editor/agent backup files
*.bak
*.bak_*

# ==========================================================================
# Docker
# ==========================================================================
.docker/

# ==========================================================================
# Database
# ==========================================================================
*.db
*.sqlite
*.sqlite3
chroma_data/

# testing-agent scratch workspaces
.git_workspaces/
backend/.git_workspaces/

# Generated build / vault artifacts — never commit (large binaries)
backend/data/builds_vault/
backend/data/galaxy_vault/
backend/data/**/zips/
*.zip
backend/data/build_artifacts/
*.apk
*.apk.idsig
*.aab
*.ipa

# Godot runtime projects scaffolded at runtime (the engine binary itself,
# backend/godot, is a first-class tracked asset — do NOT ignore it)
backend/data/godot_projects/

# Live Jeeves own-system persist
.skeleton/

# Organism shelf + merkle ledger (runtime)
skeleton/acquired/organism/
skeleton/acquired/galaxy/
chronicle/orch.json
chronicle/board.json
chronicle/board.prev.json
chronicle/gov.json
chronicle/cage.json
chronicle/rot.json
chronicle/day.json
chronicle/conductor.json
chronicle/horizon.json
chronicle/ctx.json
chronicle/runtime.json
